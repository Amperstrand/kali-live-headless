#!/usr/bin/env bash
# .githooks/pre-commit — repo hygiene gate.
#
# The repo is PUBLIC. Every rule below exists because the corresponding
# mistake already happened here, or would be unrecoverable if it did.
#
# Install once per clone:
#   git config core.hooksPath .githooks
# Run over the whole tree (CI, or before a release):
#   .githooks/pre-commit --all
#
# Rules:
#   1. shell syntax     bash -n / sh -n for every shell file that is staged
#   2. shellcheck       error + warning severities only (info/style is noise)
#   3. leak scan        public IPv4 that isn't a documented resolver, MAC
#                       addresses, private keys, tokens, and any literal value
#                       of a secret-bearing key in ./config (compared without
#                       ever printing the value)
#   4. artifact guard   no ISO / disk-image bytes (they bake the PSK, host keys
#                       and console password; version by provenance instead)
#   5. mode gates       a shebang file the runtime execs must be 100755 —
#                       AGENTS.md #16: a 100644 script under an `-x` guard
#                       ships the feature dead with zero errors
#   6. formatting       trailing whitespace, CRLF, missing final newline, and
#                       any file over 2 MB
#
# Escape hatches, used sparingly and with a reason in the same line:
#   leak-ok: <why>      the line legitimately contains a public address
#                       (e.g. an example in documentation)
#   nocover: <why>      shellcheck cannot see the sourced context
set -uo pipefail

cd "$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "pre-commit: not a git repo" >&2; exit 1; }

ALL=false
case "${1:-}" in
    --all) ALL=true ;;
    -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

FILES=()
if $ALL; then
    while IFS= read -r -d '' f; do FILES+=("$f"); done < <(git ls-files -z)
else
    while IFS= read -r -d '' f; do FILES+=("$f"); done < <(git diff --cached -z --name-only --diff-filter=ACMR)
fi
[ ${#FILES[@]} -gt 0 ] || { echo "pre-commit: nothing staged"; exit 0; }

FAIL=0
fail() { FAIL=$((FAIL + 1)); printf '  FAIL  %s\n' "$*"; }
ok()   { printf '  ok    %s\n' "$*"; }

# ---- file classification ----------------------------------------------------
is_text() {
    case "$1" in
        *.png|*.jpg|*.jpeg|*.gif|*.pdf|*.zip|*.gz|*.xz|*.zst|*.iso|*.img|*.qcow2|*.raw|*.vmdk|*.bin|*.o|*.so|*.pyc) return 1 ;;
    esac
    # a shipped binary need not have a suffix (the tollgate client is 9.9 MB
    # with no extension): trust the MIME type when `file` is available
    if command -v file >/dev/null 2>&1; then
        case "$(file -b --mime-type -- "$1" 2>/dev/null)" in
            text/*|inode/x-empty|application/json|application/xml) return 0 ;;
            '') return 0 ;;
            *) return 1 ;;
        esac
    fi
    return 0
}
shebang_of() { sed -n '1s/^#!//p' "$1" 2>/dev/null | awk '{print $1}'; }
is_shell() {
    local f=$1 sb
    sb=$(shebang_of "$f")
    case "$sb" in
        */bash|*/sh|*/dash|*/ksh) return 0 ;;
    esac
    case "$f" in *.sh|*.bash) return 0 ;; esac
    return 1
}

echo "pre-commit: ${#FILES[@]} file(s)"

# ---- 1. syntax + 2. shellcheck ---------------------------------------------
SHELL_FILES=()
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    is_text "$f" || continue
    is_shell "$f" || continue
    SHELL_FILES+=("$f")
done

for f in "${SHELL_FILES[@]}"; do :; done   # (keeps set -u happy on empty arrays)
if [ ${#SHELL_FILES[@]} -gt 0 ]; then
    SYNTAX_BAD=0
    for f in "${SHELL_FILES[@]}"; do
        sb=$(shebang_of "$f")
        case "$sb" in
            */bash) prog=/bin/bash ;;
            *)      prog=/bin/sh ;;
        esac
        if ! err=$("$prog" -n "$f" 2>&1); then
            fail "syntax: $f — $(printf '%s' "$err" | head -1)"
            SYNTAX_BAD=$((SYNTAX_BAD + 1))
        fi
    done
    [ "$SYNTAX_BAD" = 0 ] && ok "shell syntax (${#SHELL_FILES[@]} file(s))"

    # Sourced fragments deliberately carry no shebang (they inherit the
    # caller's shell); shellcheck cannot know the dialect, so skip those and
    # only lint files that state it.
    LINT_FILES=()
    for f in "${SHELL_FILES[@]}"; do
        [ -n "$(shebang_of "$f")" ] && LINT_FILES+=("$f")
    done
    if command -v shellcheck >/dev/null 2>&1 && [ ${#LINT_FILES[@]} -gt 0 ]; then
        SC_OUT=$(shellcheck -S warning -f gcc "${LINT_FILES[@]}" 2>&1 || true)
        if [ -n "$SC_OUT" ]; then
            printf '%s\n' "$SC_OUT" | while IFS= read -r line; do fail "shellcheck: $line"; done
            FAIL=$((FAIL + $(printf '%s\n' "$SC_OUT" | wc -l)))
        else
            ok "shellcheck (warning+)"
        fi
    else
        printf '  skip  shellcheck not installed (apt install shellcheck)\n'
    fi
fi

# ---- 3. leak scan -----------------------------------------------------------
# Public addresses that are fine to document: the resolvers guests are pinned
# to, and the RFC 5737 documentation ranges (filtered out below anyway).
ALLOW_PUBLIC=" 9.9.9.9 149.112.112.112 1.1.1.1 1.0.0.1 8.8.8.8 8.8.4.4 208.67.222.222 208.67.220.220 "

is_private_ip() { # $1 = dotted quad; 0 = private/special (not a leak)
    local a b c d
    IFS=. read -r a b c d <<<"$1"; : "${d:-}"
    [ "$a" = 10 ] && return 0
    [ "$a" = 127 ] && return 0
    [ "$a" = 0 ] && return 0
    [ "$a" -ge 224 ] 2>/dev/null && return 0
    [ "$a" = 169 ] && [ "$b" = 254 ] && return 0
    [ "$a" = 172 ] && [ "$b" -ge 16 ] 2>/dev/null && [ "$b" -le 31 ] && return 0
    [ "$a" = 192 ] && [ "$b" = 168 ] && return 0
    [ "$a" = 192 ] && [ "$b" = 0 ] && [ "$c" = 2 ] && return 0      # RFC 5737
    [ "$a" = 198 ] && [ "$b" = 51 ] && [ "$c" = 100 ] && return 0   # RFC 5737
    [ "$a" = 203 ] && [ "$b" = 0 ] && [ "$c" = 113 ] && return 0    # RFC 5737
    return 1
}

LEAKS=0
scan_lines() { # $1 = file, $2 = ERE, $3 = description
    local f=$1 pat=$2 what=$3 hits
    hits=$(grep -nE -- "$pat" "$f" 2>/dev/null | grep -v 'leak-ok:' || true)
    [ -n "$hits" ] || return 0
    while IFS= read -r h; do
        fail "leak ($what): $f:${h%%:*}"
        LEAKS=$((LEAKS + 1))
    done <<<"$hits"
}

for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    is_text "$f" || continue

    # public IPv4 (private/special ranges and documented resolvers excluded)
    while IFS= read -r ip; do
        [ -n "$ip" ] || continue
        case "$ALLOW_PUBLIC" in *" $ip "*) continue ;; esac
        is_private_ip "$ip" && continue
        ln=$(grep -nF -- "$ip" "$f" | grep -v 'leak-ok:' | head -1 | cut -d: -f1)
        [ -n "$ln" ] && { fail "leak (public address): $f:$ln"; LEAKS=$((LEAKS + 1)); }
    done < <(grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' "$f" 2>/dev/null | sort -u)

    # placeholder MACs are documentation; real ones are geolocatable
    for mac in $(grep -oE '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' "$f" 2>/dev/null | sort -u); do
        case "${mac,,}" in
            00:00:00:00:00:00|ff:ff:ff:ff:ff:ff|00:11:22:33:44:55|aa:bb:cc:dd:ee:ff|de:ad:be:ef:00:00|12:34:56:78:9a:bc) continue ;;
        esac
        grep -q 'leak-ok:' <<<"$(grep -nF -- "$mac" "$f" | head -1)" && continue
        ln=$(grep -nF -- "$mac" "$f" | head -1 | cut -d: -f1)
        fail "leak (MAC address): $f:$ln"
        LEAKS=$((LEAKS + 1))
    done
    scan_lines "$f" '-----BEGIN [A-Z ]*PRIVATE KEY-----' 'private key'
    scan_lines "$f" 'AKIA[0-9A-Z]{16}' 'AWS access key id'
    scan_lines "$f" '(ghp|gho|ghs|ghu)_[A-Za-z0-9]{30,}' 'GitHub token'
    scan_lines "$f" 'github_pat_[A-Za-z0-9_]{20,}' 'GitHub token'
    scan_lines "$f" 'xox[baprs]-[A-Za-z0-9-]{10,}' 'Slack token'
    scan_lines "$f" '(sk|rk)-[A-Za-z0-9]{32,}' 'API token'
    # a literal wifi PSK in a config-ish file (variables are fine: wpa-psk=$PSK)
    scan_lines "$f" '(^|[[:space:]])(wpa-)?psk=[^$"'"'"'[:space:]]{8,}' 'literal PSK'
done

# The strongest check: does any staged file contain a value from ./config?
# Values are never printed — only the key name and the location.
if [ -f ./config ]; then
    while IFS= read -r kvline; do
        case "$kvline" in ''|\#*) continue ;; esac
        key=${kvline%%=*}
        val=${kvline#*=}
        val=${val%\"}; val=${val#\"}; val=${val%\'}; val=${val#\'}
        case "$key" in PSK|SSID|BSSID|PASS|PASSWORD|KEY|TOKEN|SECRET|ENDPOINT|SALT|NPUB|NSEC) ;; *) continue ;; esac
        [ ${#val} -ge 8 ] || continue
        case "$val" in *'<'*|*'$'*|*changeme*|*CHANGEME*|*xxx*) continue ;; esac
        for f in "${FILES[@]}"; do
            [ -f "$f" ] || continue
            if grep -qF -- "$val" "$f" 2>/dev/null; then
                ln=$(grep -nF -- "$val" "$f" | head -1 | cut -d: -f1)
                fail "leak: $f:$ln contains the value of $key from ./config"
                LEAKS=$((LEAKS + 1))
            fi
        done
    done < ./config
fi
[ "$LEAKS" = 0 ] && ok "no public addresses, MACs, keys or ./config secrets"

# ---- 4. artifact guard ------------------------------------------------------
for f in "${FILES[@]}"; do
    case "$f" in
        *.iso|*.img|*.qcow2|*.raw|*.vmdk|*.image)
            fail "artifact: $f — images bake the PSK/host keys; version by provenance (BUILDS.md)" ;;
    esac
done

# ---- 5. mode gates ----------------------------------------------------------
mode_bad=0
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    is_shell "$f" || continue
    [ -n "$(shebang_of "$f")" ] || continue   # sourced fragment: no +x by design
    # only files the runtime executes: shipped tools and repo tools
    case "$f" in
        tools/*|overlay/*/usr/local/sbin/*|overlay/*/usr/local/bin/*|hooks/*|test/stages/*|test.sh|build.sh|flash.sh) ;;
        *) continue ;;
    esac
    m=$(git ls-files -s -- "$f" | awk '{print $1}' | head -1)
    [ -n "$m" ] || m=$(git diff --cached --raw -- "$f" | awk '{print $1}' | head -1)
    if [ "$m" != "100755" ]; then
        fail "mode: $f is $m, must be 100755 (an -x guard would silently disable it)"
        mode_bad=$((mode_bad + 1))
    fi
done
[ "$mode_bad" = 0 ] && ok "executable bits on shipped shell files"

# ---- 6. formatting ----------------------------------------------------------
fmt_bad=0
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    is_text "$f" || continue
    size=$(wc -c <"$f")
    if [ "$size" -gt 2097152 ]; then
        fail "size: $f is $((size / 1024)) KiB (limit 2 MiB)"
        fmt_bad=$((fmt_bad + 1))
    fi
    if grep -qP '[ \t]+$' "$f" 2>/dev/null; then
        ln=$(grep -nP '[ \t]+$' "$f" | head -1 | cut -d: -f1)
        fail "whitespace: trailing spaces at $f:$ln"
        fmt_bad=$((fmt_bad + 1))
    fi
    if grep -q $'\r' "$f" 2>/dev/null; then
        fail "line endings: CR found in $f (use LF)"
        fmt_bad=$((fmt_bad + 1))
    fi
    if [ "$size" -gt 0 ] && [ -n "$(tail -c 1 "$f")" ]; then
        fail "newline: $f does not end with a newline"
        fmt_bad=$((fmt_bad + 1))
    fi
done
[ "$fmt_bad" = 0 ] && ok "formatting (whitespace, line endings, size)"

# ---- verdict ----------------------------------------------------------------
if [ "$FAIL" -gt 0 ]; then
    printf '\npre-commit: %d problem(s) — fix, or use the documented escape hatch.\n' "$FAIL" >&2
    printf 'Bypass (only with a reason):  git commit --no-verify\n' >&2
    exit 1
fi
printf 'pre-commit: clean\n'
