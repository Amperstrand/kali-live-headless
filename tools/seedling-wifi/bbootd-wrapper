#!/bin/sh
# bbootd wrapper (remote-unlock, "leave the stick in the machine" mode).
# Installed by hook-bboot-wifi as /sbin/bbootd; the real binary is
# /sbin/bbootd.real. Captures bbootd's stdout through a fifo (bbootd
# honors BBOOT_CONSOLE=stdout — set here, on the exec line, because
# premount-script exports do NOT cross the subshell boundary), mirrors
# every line to the console, and ships the unlock URI to the relay
# NIP-44-encrypted to the owner (bunlock on the workstation answers it).
# bb.noremote=1 on the kernel cmdline disables the whole mechanism.
set -u

if [ -e /run/bboot.remote-done ] || [ ! -x /sbin/bbootd.real ]; then
	exec /sbin/bbootd.real "$@"
fi

# bb.reboot-on-fail: if the Seedling boot fails, force an immediate reboot
# instead of letting the initramfs panic handler drop to a BusyBox shell.
# This is what enables A/B boot assessment — the reboot decrements the
# boot counter and eventually falls back to the known-good entry.
WATCHDOG_SEC=0
REBOOT_ON_FAIL=0
RESCUE=0
for x in $(cat /proc/cmdline 2>/dev/null); do
	case "$x" in
		bb.reboot-on-fail=1) REBOOT_ON_FAIL=1 ;;
		bb.watchdog-sec=*) WATCHDOG_SEC="${x#bb.watchdog-sec=}" ;;
		bb.rescue=1) RESCUE=1 ;;
	esac
done
if [ "$RESCUE" = 1 ]; then
	# serial-identifiable: the e2e rescue stages grep for this line to
	# prove WHICH medium booted (the rescue stick, not the primary)
	echo "bboot-wifi: RESCUE MEDIUM — pinned manifest, wifi/announcer off" > /dev/console 2>&1
fi
if [ "$REBOOT_ON_FAIL" = 1 ]; then
	# watch for bbootd's failure marker and reboot when it appears
	(
		while [ ! -e /run/bboot/failed ]; do
			sleep 2
		done
		echo "bboot-wifi: boot FAILED — rebooting (bb.reboot-on-fail=1)" > /dev/console 2>&1
		sync
		sleep 1
		reboot -f
	) </dev/null >/dev/null 2>&1 &
fi

if [ "$WATCHDOG_SEC" -gt 0 ] 2>/dev/null; then
	# BB_RUN_DIR is a test hook (AGENTS #31 pattern): unit.sh exercises
	# the loop with a tmpdir and a mocked reboot instead of a VM hang
	BB_RUN_DIR=${BB_RUN_DIR:-/run/bboot}
	(
		i=0
		while [ $i -lt "$WATCHDOG_SEC" ]; do
			[ -e "$BB_RUN_DIR/ready" ] && exit 0
			[ -e "$BB_RUN_DIR/failed" ] && exit 0
			sleep 1
			i=$((i + 1))
		done
		echo "bboot-wifi: watchdog expired after ${WATCHDOG_SEC}s — rebooting" > /dev/console 2>&1
		sync
		reboot -f
	) </dev/null >/dev/null 2>&1 &
	echo "bboot-wifi: watchdog armed (${WATCHDOG_SEC}s)" > /dev/console 2>&1
fi
: > /run/bboot.remote-done

case " $(cat /proc/cmdline 2>/dev/null) " in
*" bb.noremote=1 "*|*" bb.nowifi=1 "*|*" bb.rescue=1 "*)
	# bb.nowifi disables the whole wifi/remote machinery, this reader
	# included — the nowifi stage caught it running anyway. bb.rescue
	# implies the same: the rescue medium minimizes its dependency
	# surface (wired-only, no announcer) and must never hang waiting
	# for wifi or relays.
	exec /sbin/bbootd.real "$@" ;;
esac

mkdir -p /run 2>/dev/null
mkfifo /run/bboot.out 2>/dev/null || exec /sbin/bbootd.real "$@"
[ -p /run/bboot.out ] || exec /sbin/bbootd.real "$@"

R=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^bb.relays=//p' | cut -d, -f1)
OWNER=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^bb.npub=//p' | cut -d, -f1)

# the ANNOUNCER: fully detached (no fifo fds — blocking it can stall bbootd
# through the fifo, which is exactly how the hwsim chunk-storm regression
# happened), polls for the captured URI, retries through bridge congestion
if [ -n "$R" ] && [ -x /usr/local/sbin/bannounce ]; then
	(
		n=0
		while [ ! -s /run/bboot.uri ] && [ $n -lt 300 ]; do
			sleep 2
			n=$((n + 1))
		done
		# bounded life: the announcer must not outlive its usefulness —
		# after switch_root the initramfs's busybox vanishes and `sleep`
		# breaks, spraying errors forever (found live on the desktop)
		last=""
		pubs=0
		ticks=0
		while [ $ticks -lt 400 ] && [ $pubs -lt 12 ]; do
			command -v sleep >/dev/null 2>&1 || exit 0
			if [ -s /run/bboot.uri ]; then
				URI=$(cat /run/bboot.uri)
				if [ "$URI" != "$last" ]; then
					a=0
					while [ $a -lt 5 ]; do
						if timeout 25 /usr/local/sbin/bannounce -relay "$R" -owner "$OWNER" -uri "$URI"; then
							last=$URI
							pubs=$((pubs + 1))
							break
						fi
						a=$((a + 1))
						sleep 5
					done
				fi
			fi
			sleep 3
			ticks=$((ticks + 1))
		done
		exit 0
	) </dev/null >/dev/console 2>&1 &
fi

# reader FIRST: the exec below opens the fifo for write, which blocks
# until a reader exists — forking the reader after the exec deadlocks.
(
	i=0
	while IFS= read -r l; do
		printf '%s\n' "$l" > /dev/console 2>&1
		case "$l" in
		*nostrconnect://*)
			URI=$(printf '%s' "$l" | grep -o 'nostrconnect://[^ ]*' | head -1)
			if [ -n "$URI" ]; then
				printf '%s\n' "$URI" > /run/bboot.uri
				echo "bboot-wifi: unlock URI captured (announce detached)" > /dev/console 2>&1
			fi
			;;
		esac
		i=$((i + 1))
	done < /run/bboot.out
) &

exec >/run/bboot.out 2>&1
BBOOT_CONSOLE=stdout exec /sbin/bbootd.real "$@"
