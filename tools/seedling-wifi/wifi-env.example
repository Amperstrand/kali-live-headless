# wifi-env.example — copy to $SEEDLING_DIR/wifi-env.sh (OUTSIDE the repo)
# and fill in. The workspace copy holds real values; this example keeps the
# repo free of machine addresses.
SEEDLING_DIR=/home/user/src/seedling-m1
CONTAINER=m1build
MANIFEST=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NPUB=npub1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# only needed for the 'hw' variant and e2e signing:
RELAY_HOST=192.168.1.2
RELAY_PORT=8443
# optional: a LAN NTP server tried before the public pools (dead-RTC machines)
NTP_LAN=192.168.1.1
# e2e also expects, in SEEDLING_DIR:
#   .m1-nsec            the test nsec (never printed, never committed)
#   testenv-m1/pki/ca.crt  the testenv CA
