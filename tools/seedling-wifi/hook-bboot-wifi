#!/bin/sh
# bboot-wifi initramfs hook: copy wpa_supplicant, iw, hostapd, all installed
# firmware, and the wireless module stack into the initrd.
# Installed by inject-wifi.sh (our overlay; Seedling's tree is untouched).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
	prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

for b in /sbin/wpa_supplicant /usr/sbin/wpa_supplicant; do
	[ -x "$b" ] && copy_exec "$b"
done
for b in /sbin/iw /usr/sbin/iw; do
	[ -x "$b" ] && copy_exec "$b"
done
[ -x /usr/sbin/hostapd ] && copy_exec /usr/sbin/hostapd
[ -x /usr/local/sbin/bbirth ] && copy_exec /usr/local/sbin/bbirth
[ -x /usr/local/sbin/bannounce ] && copy_exec /usr/local/sbin/bannounce

# remote-unlock wrapper: our hook runs AFTER theirs (alphabetical), so
# /sbin/bbootd is already in DESTDIR — rename it and put the wrapper in
# its place. The wrapper sets BBOOT_CONSOLE on its own exec line (env
# from premount scripts does not cross the subshell boundary).
if [ -x "$DESTDIR/sbin/bbootd" ] && [ ! -e "$DESTDIR/sbin/bbootd.real" ]; then
	mv "$DESTDIR/sbin/bbootd" "$DESTDIR/sbin/bbootd.real"
	install -m 0755 /etc/initramfs-tools/bbootd-wrapper "$DESTDIR/sbin/bbootd" 2>/dev/null ||
		cp /etc/initramfs-tools/bbootd-wrapper "$DESTDIR/sbin/bbootd"
	chmod 0755 "$DESTDIR/sbin/bbootd"
fi

# dropbear's init-bottom brings ALL interfaces down (IFDOWN=*) when the
# ramdisk exits — but the bboot NBD root fetches chunks lazily AFTER that
# point, so killing the network there stalls the boot at "chunk N: context
# deadline exceeded" forever (found by e2e 2026-11-13: every full-boot
# stage died post-unlock since dropbear landed; the Nov 11 boots predate
# dropbear). IFDOWN=none is the documented knob: keep interfaces up,
# preserve routing. Both dropbear scripts source this conf AFTER their
# defaults, so it wins.
if [ -f "$DESTDIR/etc/dropbear/dropbear.conf" ]; then
	grep -q '^IFDOWN=' "$DESTDIR/etc/dropbear/dropbear.conf" 2>/dev/null ||
		echo 'IFDOWN=none' >> "$DESTDIR/etc/dropbear/dropbear.conf"
else
	mkdir -p "$DESTDIR/etc/dropbear"
	printf 'IFDOWN=none\n' > "$DESTDIR/etc/dropbear/dropbear.conf"
fi

# regulatory database + every installed firmware blob (the rootfs carries only
# the Wi-Fi firmware packages, so this is bounded by that set)
if [ -d /lib/firmware ]; then
	mkdir -p "$DESTDIR/lib/firmware"
	cp -a /lib/firmware/. "$DESTDIR/lib/firmware/"
fi

# the ENTIRE wireless driver tree (found 2026-11-05: MODULES=most does NOT
# include drivers/net/wireless at all — a hand list missed rtw89_8852ae and
# would have shipped ai-legion-small's radio dead). Every module the kernel
# ships, ~25 MB compressed — cheap insurance.
kroot=/lib/modules
for kdir in "$kroot"/*/kernel; do
	[ -d "$kdir/drivers/net/wireless" ] || continue
	find "$kdir/drivers/net/wireless" -name '*.ko*' | while read -r ko; do
		b=${ko##*/}; b=${b%%.ko*}
		manual_add_modules "$b" 2>/dev/null || true
	done
done
manual_add_modules cfg80211 mac80211 || true
manual_add_modules mac80211_hwsim || true

# mount the stick's ESP to read wifi.conf: vfat + its nls codepages, plus the
# storage transports a real stick can hang off (usb-storage/uas/xhci, virtio
# for QEMU). MODULES=most does NOT include vfat (found 2026-11-05: the mount
# failed silently and the script reported 'no wifi.conf').
for m in fat vfat nls_cp437 nls_iso8859_1 nls_ascii \
	usb-storage uas xhci_pci ehci_pci \
	virtio_blk virtio_pci; do
	manual_add_modules "$m" 2>/dev/null || true
done

# offline rescue (boot=klhrescue): loop-mount the static recovery erofs
# off the stick's ESP — loop + overlay are the two it cannot boot without
manual_add_modules loop 2>/dev/null || true
manual_add_modules overlay 2>/dev/null || true

# WPA2 data-path crypto (CCMP/AES): without these the kernel REJECTS key
# installation (nl80211 "key addition failed" — found via the hwsim test;
# real hardware needs them just as much)
for m in arc4 ecb cbc ccm cmac gcm aes_x86_64 aes_generic bridge; do
	manual_add_modules "$m" 2>/dev/null || true
done
