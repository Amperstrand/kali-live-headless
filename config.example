# kali-live-headless configuration
#
# Copy to ./config and edit, or simply run: ./configure.sh
#
# SECURITY: after you fill this in, ./config contains your Wi-Fi passphrase
# in PLAINTEXT (unattended Wi-Fi requires a recoverable credential on the
# boot medium — see README.md "Threat model"). ./config is git-ignored and
# should be chmod 600. Do not commit it anywhere.

# --- Identity ---------------------------------------------------------
# Hostname of the live system (also the mDNS name: <hostname>.local)
HOSTNAME=kali-live

# --- Wi-Fi ------------------------------------------------------------
WIFI_SSID=MyHomeNetwork
WIFI_PSK=change-me-8-to-63-characters
# wpa-psk = WPA2-Personal (also works on WPA2/WPA3 "transition" networks)
# sae     = WPA3-Personal (AP, driver and wpa_supplicant must support SAE)
WIFI_KEYMGMT=wpa-psk
# Set to true if the SSID is hidden (not broadcast)
WIFI_HIDDEN=false
# ISO 3166-1 alpha-2 regulatory domain (e.g. US, DE, GB). Empty = skip.
WIFI_REGDOM=US

# --- SSH --------------------------------------------------------------
# Path to your PUBLIC key (the private key never goes on the USB stick)
SSH_PUBKEY_PATH=~/.ssh/id_ed25519.pub
# Optional: extra public keys (space-separated) merged into authorized_keys
# (useful for a dedicated test key)
SSH_EXTRA_PUBKEYS=

# --- Boot behavior ------------------------------------------------------
# Default boot-menu entry (auto-boots after 5s in any case):
#   live     = standard Kali Live (default)
#   forensic = forensic mode (no swap on, no automounting of internal disks)
BOOT_DEFAULT=live
# random = console password for user 'kali' is randomized EVERY boot
#          (SSH is key-only anyway, sudo is passwordless — the password
#          only matters for physical-console logins)
# kali   = standard Kali live behavior (kali/kali on the console)
LIVE_PASSWORD_MODE=random
# Bake in the KVM/libvirt stack (libvirtd enabled, virt-manager +
# virt-install, nested virt on, guests NAT-isolated from the host)
WITH_KVM=true

# --- Build --------------------------------------------------------------
# Pinned upstream kali-live commit — reproducible builds.
KALI_LIVE_REF=adb2e38941662f105b57134e0155ec468da294ad
VARIANT=default
ARCH=amd64
BRANCH=kali-rolling
#BUILD_MIRROR=http://kali.download/kali
#OUT_DIR=output

# WireGuard access channel (all NON-secret: the stick generates its own
# private key on first boot and persists it to the KLHCONFIG partition).
# Leave WG_ENDPOINT empty to ship the feature dormant.
#WG_ENDPOINT=inr2.example.com
#WG_PEER_PUBKEY=+pasteTheHubs44CharBase64PublicKeyFromWgPubkey=
#WG_TUNNET=10.66
#WG_HUB_ADDR=10.99.0.1
#WG_PORT=51820

# Optimistic BitLocker unlock for the VM store (kali-live-bitlocker-mount):
# off (default) = never touch a locked volume; try = tooling may mount a
# store on one when a key is legitimately available (clear key on the
# volume, or a recovery password / .BEK in KLHCONFIG bitlocker.conf).
#VMSTORE_BITLOCKER=off

# FIPS mesh: the peer every stick dials at boot (our exit node). The fips
# daemon ships in the image with a per-machine identity derived from the
# stick's master salt (see README "deterministic identities").
# FIPS mesh (v20 optionality): FIPS_ENABLED=false ships the mesh fully
# dormant (no wg0, no enrollment, no daemon peering); flip per stick at
# runtime with KLHCONFIG:/fips.conf — no rebuild.
#FIPS_ENABLED=true
# The hub/bridge the stick peers with — ./config-ONLY value; never commit
# the real address to this public repo. Empty = feature dormant.
#FIPS_PEER_ADDR=your-bridge.example:2121
#FIPS_PEER_NPUB=npub1...
