#!/bin/sh
# live-build chroot hook (runs INSIDE the chroot during the ISO build,
# sorted to run after kali-hacks.chroot).
#
# Enables the services the headless image needs and validates sshd config.
# SSH host keys are generated here as well if openssh-server's postinst
# did not already do it — making them unique per ISO build and stable
# across boots of the same USB stick.

set -e

echo "I: zz-headless-configure: enabling services"

# Services (idempotent; enable works fine in a chroot, it only creates symlinks)
systemctl enable ssh.service 2>&1 || true
systemctl enable NetworkManager.service 2>&1 || true
systemctl enable avahi-daemon.service 2>&1 || true
systemctl enable kali-live-headless-provision.service 2>&1 || true
systemctl enable kali-live-console-banner.service 2>&1 || true
systemctl enable kali-live-wifi-watchdog.service 2>&1 || true
systemctl enable kali-live-tollgate-watchdog.service 2>&1 || true
systemctl enable kali-live-rescue.service 2>&1 || true
systemctl enable kali-live-vm-forward-reassert.timer 2>&1 || true

# DEFENSE: enforce exec bits on every shipped script — a git mode mishap
# once shipped 0644 units (203/EXEC) twice; never again (test.sh also asserts)
for f in /usr/local/sbin/kali-live-*; do
    [ -e "$f" ] && chmod 0755 "$f"
done

# KVM/libvirt stack (packages present only on WITH_KVM builds)
systemctl enable libvirtd.service 2>&1 || true
systemctl enable virtlogd.socket 2>&1 || true
systemctl enable kali-live-kvm-enable.service 2>&1 || true
systemctl enable kali-live-kvm-firewall.service 2>&1 || true
# Opt-in NTFS VM store: enabled unconditionally on WITH_KVM builds; the
# mount script itself no-ops (success) unless KLHCONFIG carries a valid
# vm-store.conf — the feature ships disabled by design.
systemctl enable kali-live-vmstore-mount.service 2>&1 || true

# Deterministic virbr0: autostart the default network (kali-live-kvm-enable
# also does it at runtime — socket-activation makes that work even when
# libvirtd.service is not up). This symlink is the belt to its braces.
# NB: default.xml usually does NOT exist in the build chroot (libvirtd
# creates it on first run, not at package install) — so do NOT gate on
# it: a dangling ../default.xml symlink is harmless and resolves the
# moment libvirtd materializes the file (build #14 hardware lesson:
# the gated version silently never created anything).
if [ -d /var/lib/libvirt/qemu/networks ]; then
    mkdir -p /var/lib/libvirt/qemu/networks/autostart
    ln -sf ../default.xml /var/lib/libvirt/qemu/networks/autostart/default.xml
fi

# console banner writes here (getty shows /etc/issue.d/* on the prompt)
install -d -m 0755 /etc/issue.d 2>/dev/null || true

# Audit rules: watch for tampering with identity/credential files.
# These fire on ANY write to the files that hold the stick's identity
# and access credentials — after first-boot provisioning, nothing should
# touch them. Check with: ausearch -k klh-identity
if command -v auditctl >/dev/null 2>&1; then
    auditctl -w /etc/fips/fips.key -p wa -k klh-identity 2>/dev/null || true
    auditctl -w /etc/wireguard/wg0.conf -p wa -k klh-identity 2>/dev/null || true
    auditctl -w /etc/ssh/sshd_config.d/ -p wa -k klh-sshd 2>/dev/null || true
fi

# FIPS mesh DNS: the fips deb ships fips-dns (a local resolver for .fips
# hostnames), but the live system's nsswitch doesn't know about it. Wire it
# so `ping peer.fips` works alongside npub/IPv6 addressing.
if [ -x /usr/bin/fips-dns ] || [ -x /usr/local/bin/fips-dns ]; then
    if ! grep -q "fips" /etc/nsswitch.conf 2>/dev/null; then
        sed -i 's/^hosts:.*/hosts: files mymachines fips dns [!UNAVAIL=return] mdns4_minimal [NOTFOUND=return]/' /etc/nsswitch.conf 2>/dev/null || true
    fi
fi

# Passwordless sudo for the live user must be 0440 and syntactically valid
if [ -f /etc/sudoers.d/kali-live-headless ]; then
    chown root:root /etc/sudoers.d/kali-live-headless
    chmod 0440 /etc/sudoers.d/kali-live-headless
    visudo -cf /etc/sudoers.d/kali-live-headless > /dev/null 2>&1 \
        || { echo "E: zz-headless-configure: invalid sudoers file"; exit 1; }
fi

# NetworkManager profile must be root:root 0600 (NM refuses world/group readable)
if [ -e /etc/NetworkManager/system-connections/headless-wifi.nmconnection ]; then
    chown root:root /etc/NetworkManager/system-connections/headless-wifi.nmconnection
    chmod 0600 /etc/NetworkManager/system-connections/headless-wifi.nmconnection
fi

# authorized_keys into /etc/skel — live-config creates the live user 'kali'
# from the skeleton on EVERY boot, so this is how the key reaches
# /home/kali/.ssh/authorized_keys without any console interaction.
if [ -s /etc/kali-live-headless/authorized_keys ]; then
    install -d -m 0700 /etc/skel/.ssh
    install -m 0600 /etc/kali-live-headless/authorized_keys /etc/skel/.ssh/authorized_keys
fi

# sshd needs its privilege separation directory even for config tests
install -d -m 0755 /run/sshd

# Unique-per-build host keys (usually already generated by the
# openssh-server postinst during the chroot phase — keep it idempotent)
ssh-keygen -A > /dev/null 2>&1 || true

# Validate sshd configuration — the build fails loudly on a bad config
if /usr/sbin/sshd -t 2>/tmp/sshd-t.err; then
    echo "I: zz-headless-configure: sshd config valid"
else
    echo "E: zz-headless-configure: sshd config INVALID:"
    cat /tmp/sshd-t.err >&2
    rm -f /tmp/sshd-t.err
    exit 1
fi
rm -f /tmp/sshd-t.err

echo "I: zz-headless-configure: done"
