#!/bin/sh
# klh-apt-cache.hook.build — warm-build enabler (2026-10-25; symlink
# semantics fixed 2026-10-26 after the first real run).
#
# Upstream wipes cache/ TWICE per build (stage [1/4] AND its final
# cleanup_fs at build.sh:629), so live-build's own cache/packages.chroot
# persistence never survives to help the next build, and a symlink planted
# at staging time is destroyed by the stage-1 wipe before lb ever runs.
# This hook executes at `lb build` START — after the wipe, before any
# package install — which is the only window that works:
#
#   cache/packages.chroot -> ../.klh-apt-cache   (a dotdir the clean
#                                               lists never touch)
#
# lb then reads AND writes the cache through the link: this build's
# downloads land in the dotdir, and the next build seeds its chroot from
# them natively. No copies, no timing window, no restore step.
#
# Fail-open by design: no dotdir (fresh clone), wrong cwd, or a hostile
# cache dir — the build proceeds exactly as without this hook.
set -u

CACHE_LINK="cache/packages.chroot"
CACHE_REAL="../.klh-apt-cache"

[ -d .klh-apt-cache ] || exit 0

# already linked (same inode)? nothing to do
[ "$CACHE_LINK" -ef .klh-apt-cache ] && exit 0

mkdir -p cache 2>/dev/null || exit 0
# a REAL directory here means lb (or a prior build) made one: fold its
# debs into the dotdir, then replace it with the link
if [ -d "$CACHE_LINK" ] && [ ! -L "$CACHE_LINK" ]; then
  n=0
  for f in "$CACHE_LINK"/*.deb; do
    [ -e "$f" ] || break
    cp -n "$f" .klh-apt-cache/ 2>/dev/null && n=$((n + 1))
  done
  [ "$n" -gt 0 ] && echo "klh-apt-cache: folded $n debs from a stale cache dir"
  rm -rf "$CACHE_LINK"
fi
ln -sfn "$CACHE_REAL" "$CACHE_LINK" 2>/dev/null || exit 0
echo "klh-apt-cache: linked cache/packages.chroot -> .klh-apt-cache ($(ls .klh-apt-cache/*.deb 2>/dev/null | wc -l) debs warm for this build)"

exit 0
