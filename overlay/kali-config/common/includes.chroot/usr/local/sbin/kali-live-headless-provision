#!/bin/sh
# kali-live-headless one-shot provisioner.
#
# Runs on every live boot (idempotent). Guarantees that the headless
# configuration survives Kali's live initialization (live-config), no
# matter which boot menu entry (Live / forensic / persistence) was used:
#
#   1. hostname (overrides the hard-coded hostname=kali of the syslinux
#      forensic entry and any kernel cmdline default)
#   2. live user 'kali' exists (live-config normally creates it from
#      /etc/skel; fallback for exotic boots)
#   3. /home/kali/.ssh/authorized_keys installed with correct ownership
#   4. sshd hardening drop-in present
#   5. SSH host keys present (baked at build time; regenerated if lost)
#   6. Wi-Fi regulatory domain applied before NetworkManager starts
#   7. avahi re-registered under the new hostname
#   8. Wi-Fi credential OVERRIDE from a boot-medium config partition:
#      a partition labeled KLHCONFIG may carry headless-wifi.conf
#      (HOSTNAME/WIFI_SSID/WIFI_PSK/WIFI_KEYMGMT/WIFI_HIDDEN/WIFI_REGDOM,
#      plain KEY=value lines). When present and valid, the NetworkManager
#      profile is REGENERATED from the template at boot — so changing the
#      Wi-Fi password is a file edit on the stick, NOT a rebuild.
#      Precedence: KLHCONFIG headless-wifi.conf > values baked into the
#      ISO at build time. An invalid file is rejected (logged, no values)
#      and the baked profile is kept.
#
# Logs to the journal AND the console. Never logs credential values.

set -u

CFG_DIR=/etc/kali-live-headless
TAG=kali-live-headless
GEN=/usr/local/sbin/kali-live-headless-wifi-gen
TEMPLATE=$CFG_DIR/headless-wifi.nmconnection.in
NM_PROFILE=/etc/NetworkManager/system-connections/headless-wifi.nmconnection
OVERRIDE_MNT=/run/kali-live-headless-config
# canonical helpers (cfgpart discovery + salt reading) — the 2026-10-25
# dedup: this script alone carried FOUR copies of the partition lookup and
# TWO salt readers; the empty-salt incident was that drift.
# Source the canonical lib. The existence test (not `. file || . file`) is
# deliberate: `.` is a POSIX special builtin, and a FAILING special builtin
# is FATAL to the shell in POSIX mode (bash-as-/bin/sh) — the || fallback
# would never run. Both paths are the same file in-image; the second makes
# the script runnable straight from a checkout (tests, dry runs).
if [ -f /usr/local/lib/kali-live-headless/klh-lib.sh ]; then
    . /usr/local/lib/kali-live-headless/klh-lib.sh
else
    . "$(dirname "$0")/../lib/kali-live-headless/klh-lib.sh"
fi

log() {
    # /dev/kmsg FIRST: kernel-log lines are captured by the journal AND are
    # readable early-boot (logger races journald startup, /dev/console output
    # never reaches the journal at all — the 2026-10-26 auto-create failure
    # on hardware left NO journal trace of its log lines for exactly this
    # reason). Falls back to logger + console for non-root callers.
    printf '<5>%s: %s\n' "$TAG" "$*" > /dev/kmsg 2>/dev/null \
        || logger -t "$TAG" -- "$*" 2>/dev/null \
        || true
}

conf_value() { # $1=file $2=KEY -> first plain KEY=value value
    [ -r "$1" ] || return 1
    sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1
}

valid_hostname() {
    [ -n "$1" ] || return 1
    case "$1" in -*|*-|*'*'*|*'?'*|*'['*) return 1 ;; esac
    printf '%s' "$1" | grep -Eq '^[A-Za-z0-9-]{1,63}$'
}

valid_regdom() {
    printf '%s' "$1" | grep -Eq '^[A-Z]{2}$'
}

# ------------------------------------------------ boot-medium config override
O_HOST=""; O_SSID=""; O_PSK=""; O_KEYMGMT=""; O_HIDDEN=""; O_REGDOM=""
O_DEV=$(klh_cfgpart)
if [ -n "$O_DEV" ] && [ -b "$O_DEV" ] \
   && mkdir -p "$OVERRIDE_MNT" 2>/dev/null \
   && mount -o ro "$O_DEV" "$OVERRIDE_MNT" 2>/dev/null; then
    if [ -r "$OVERRIDE_MNT/headless-wifi.conf" ]; then
        O_HOST=$(conf_value "$OVERRIDE_MNT/headless-wifi.conf" HOSTNAME)
        O_SSID=$(conf_value "$OVERRIDE_MNT/headless-wifi.conf" WIFI_SSID)
        O_PSK=$(conf_value "$OVERRIDE_MNT/headless-wifi.conf" WIFI_PSK)
        O_KEYMGMT=$(conf_value "$OVERRIDE_MNT/headless-wifi.conf" WIFI_KEYMGMT)
        O_HIDDEN=$(conf_value "$OVERRIDE_MNT/headless-wifi.conf" WIFI_HIDDEN)
        O_REGDOM=$(conf_value "$OVERRIDE_MNT/headless-wifi.conf" WIFI_REGDOM)
        [ -n "$O_KEYMGMT" ] || O_KEYMGMT=wpa-psk
        [ -n "$O_HIDDEN" ] || O_HIDDEN=false
        # Rescue channel opt-in (v20): RAM-only flag; the unit's
        # ConditionPathExists gates on it. LOUD by design — this is the
        # one feature that egresses to a third party.
        if [ -r "$OVERRIDE_MNT/rescue.conf" ]            && [ "$(conf_value "$OVERRIDE_MNT/rescue.conf" RESCUE_ENABLED)" = "true" ]; then
            mkdir -p /run/kali-live-headless 2>/dev/null
            : > /run/kali-live-headless/rescue-enabled
            log "RESCUE MODE ARMED by rescue.conf (trycloudflare egress on next unit start)"
        fi
        log "boot-medium config found (KLHCONFIG) — applying overrides (values not logged)"
    else
        log "KLHCONFIG partition has no headless-wifi.conf — using baked credentials"
    fi
    umount "$OVERRIDE_MNT" 2>/dev/null || true
    rmdir "$OVERRIDE_MNT" 2>/dev/null || true
fi

# ------------------------------------------------- KLHCONFIG auto-creation
# Self-healing: if the stick was flashed with plain dd (no flash.sh), the
# ISO's partition table has no KLHCONFIG partition, and EVERYTHING that
# persists lives on it: master.salt (deterministic identities!), Wi-Fi
# override, BitLocker consent, vm-store.conf, rescue opt-in. Instead of
# silently degrading, CREATE the partition on the boot device.
ensure_klhconfig_partition() {
    # Safety: we only touch the device that backs /run/live/medium (never
    # any other disk), only if there's no KLHCONFIG partition anywhere, and
    # only if there's free space past the ISO. Prints the config partition
    # dev on success (empty otherwise). POSIX sh: no `local` — the vars
    # below are uniquely named to avoid leaking into the caller's scope.
    cfgpart=$(klh_cfgpart)
    [ -z "$cfgpart" ] || { printf '%s\n' "$cfgpart"; return 0; }

    mediumpath=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || true)
    [ -n "$mediumpath" ] || return 0
    bootdev=$(lsblk -no PKNAME "$(basename "$mediumpath" | sed 's|/dev/||')" 2>/dev/null | head -1)
    [ -n "$bootdev" ] && [ -b "/dev/$bootdev" ] || return 0
    # verify it's a USB/removable device (never partition an internal disk)
    lsblk -dno TRAN "/dev/$bootdev" 2>/dev/null | grep -q "usb" || return 0
    isosize=$(blockdev --getsize64 "/dev/$bootdev" 2>/dev/null || echo 0)
    devsize=$(blockdev --getsize64 "/dev/$bootdev" 2>/dev/null || echo 0)
    isoend=$(( (isosize + 1048575) / 1048576 + 1 ))  # MiB-aligned, past ISO
    devmb=$(( devsize / 1048576 ))
    [ "$devmb" -gt $(( isoend + 64 )) ] \
        || { log "WARNING: no KLHCONFIG partition and no free space on /dev/$bootdev — identities will NOT persist"; return 0; }
    start=$(( isoend * 2048 ))
    log "no KLHCONFIG found — creating one on /dev/$bootdev (self-healing)"
    printf 'start=%s, size=131072, type=0c\n' "$start" | sfdisk --force --append "/dev/$bootdev" >/dev/null 2>&1 \
        || { log "WARNING: could not create KLHCONFIG partition on /dev/$bootdev — identities will NOT persist"; return 0; }
    # partx (util-linux, always present): partprobe is parted's and NOT in
    # the minimal image, and blockdev --rereadpt defers on busy devices —
    # proven live on the stick 2026-10-25 (table written, node never came)
    partx -u "/dev/$bootdev" 2>/dev/null || blockdev --rereadpt "/dev/$bootdev" 2>/dev/null || true
    sleep 3
    newpart=$(klh_cfgpart "/dev/$bootdev")
    if [ -n "$newpart" ] && [ -b "$newpart" ]; then
        mkfs.vfat -n KLHCONFIG "$newpart" >/dev/null 2>&1
        log "KLHCONFIG partition created: $(klh_cfgpart) (identities will persist from now on)"
        klh_cfgpart
        return 0
    fi
    log "WARNING: KLHCONFIG partition appended but device node not found — identities will NOT persist this boot"
    return 0
}
O_DEV=$(ensure_klhconfig_partition)

# ---------------------------------------------------- host-role mesh identity
# Persistent FIPS mesh identity (nsec/npub + name): generated on FIRST boot,
# persisted to KLHCONFIG, reused on every later boot. The ISO ships NO
# identity — nothing baked, nothing in git; the nsec lives only on the boot
# medium (same threat model as the Wi-Fi PSK: physical access = rotate).
if [ -n "$O_DEV" ] && [ -b "$O_DEV" ] \
   && mkdir -p "$OVERRIDE_MNT" 2>/dev/null \
   && mount -o rw "$O_DEV" "$OVERRIDE_MNT" 2>/dev/null; then
    # The salt MUST exist before any consumer runs (identity-init creates
    # it on first boot). The original order ran host_role_init first: on a
    # first boot with no pre-seeded salt, host_role saw no salt, generated
    # a throwaway RANDOM identity, and only then did identity-init create
    # the salt — so boot #1 carried a random npub that boot #2 replaced
    # (found in the 2026-10-25 pre-cut review; flashed sticks dodge it via
    # registry pre-seeding, dd-flashed sticks hit it every first boot).
    if [ -x /usr/local/sbin/kali-live-identity-init ]; then
        /usr/local/sbin/kali-live-identity-init "$OVERRIDE_MNT" >/dev/null 2>&1 || true
    fi
    if NPUB=$(/usr/local/lib/kali-live-headless/host_role_init.py "$OVERRIDE_MNT" 2>/dev/null) \
       && [ -n "$NPUB" ]; then
        echo "$NPUB" > /run/kali-live-headless-npub 2>/dev/null || true
        log "host-role mesh identity ready: $NPUB"
    else
        log "WARNING: no KLHCONFIG config mount — mesh identity NOT provisioned, WireGuard identity NOT provisioned, console password will change every boot, Wi-Fi override unavailable, BitLocker unlock unavailable. Re-flash with ./flash.sh or let the auto-creation above handle it on next boot."
    fi

    # --------------------------------------------------- FIPS mesh identity
    # Seed the FIPS daemon with the DERIVED per-machine identity (master
    # salt + fingerprint -> nsec) and point it at the staged default peer
    # (our exit node). The fips deb ships enabled-but-not-started; we also
    # enable fips-dns so .fips resolution works from boot.
    # (identity-init already ran above, BEFORE host_role — the salt exists
    # by this point; the duplicate call that used to live here was the
    # ordering bug fixed in the 2026-10-25 pre-cut review.)
    # The fips deb ships only /usr/share/fips/fips.yaml.example — nothing
    # ever copied it to /etc/fips/fips.yaml, so the seeding below skipped
    # itself and fips stayed disabled on every boot (found live 2026-10-24:
    # fips.service inactive, /etc/fips/ empty except fips.nft).
    if [ ! -f /etc/fips/fips.yaml ] && [ -f /usr/share/fips/fips.yaml.example ]; then
        cp /usr/share/fips/fips.yaml.example /etc/fips/fips.yaml 2>/dev/null || true
    fi
    SALT_FILE="$OVERRIDE_MNT/master.salt"
    SALT=$(klh_salt_of "$SALT_FILE")
    klh_salt_valid "$SALT" || SALT=""
    if [ -n "$SALT" ] && [ -f /etc/fips/fips.yaml ]; then
        DERIVED=$(python3 /usr/local/lib/kali-live-headless/derive_identity.py "$SALT" --machine --purpose fips 2>/dev/null || true)
        NSEC=$(printf '%s' "$DERIVED" | cut -f2)
        if [ -n "$NSEC" ]; then
            umask 077
            printf '%s\n' "$NSEC" > /etc/fips/fips.key
            chmod 0600 /etc/fips/fips.key
            sed -i 's/^# *persistent:.*/      persistent: true/; s/^ *persistent:.*/      persistent: true/' /etc/fips/fips.yaml
            PEER_ADDR=$(sed -n 's/^FIPS_PEER_ADDR=//p' /etc/default/kali-live-headless | head -n1 | tr -d '"')
            PEER_NPUB=$(sed -n 's/^FIPS_PEER_NPUB=//p' /etc/default/kali-live-headless | head -n1 | tr -d '"')
            if [ -n "$PEER_ADDR" ] && [ -n "$PEER_NPUB" ] && ! grep -q "$PEER_NPUB" /etc/fips/fips.yaml; then
                cat >> /etc/fips/fips.yaml <<EOFPEER

peers:
  - npub: "$PEER_NPUB"
    alias: "exit"
    addresses:
      - transport: udp
        addr: "$PEER_ADDR"
    connect_policy: auto_connect
EOFPEER
            fi
            systemctl enable fips fips-dns >/dev/null 2>&1 || true
            # --no-block: a plain `systemctl restart` from INSIDE the running
            # provision job waits for the started unit — and the fips daemon
            # dials its staged peer at startup, blocking provision for the
            # whole dial timeout. Found 2026-10-26 in the override stage: the
            # first run of this block ever (it needs a VALID salt — every
            # earlier boot skipped it: no salt, or the <32-byte fixture salt
            # derive refuses) hung provision 14+ minutes past 'mesh identity
            # ready' every time.
            systemctl --no-block restart fips >/dev/null 2>&1 || true
            log "fips mesh identity derived and seeded; peer $PEER_ADDR"
        fi
    fi

    # ------------------------------------------------------ wireguard tunnel
    # Per-stick tunnel identity (same persistence model as the host-role
    # identity above): keypair generated on FIRST boot and persisted to the
    # config partition, tunnel address derived from the PUBLIC key. Prints
    # "<pubkey> <tunnel-ip>"; secrets never leave the stick. Disabled and a
    # no-op unless WG_ENDPOINT was staged at build time (see README).
    if WGOUT=$(/usr/local/sbin/kali-live-wireguard-init "$OVERRIDE_MNT" 2>/dev/null) \
       && [ -n "$WGOUT" ]; then
        echo "${WGOUT%% *}" > /run/kali-live-headless-wg-pub 2>/dev/null || true
        log "wireguard tunnel ready: $WGOUT"
    else
        log "wireguard not provisioned (non-fatal — off, unconfigured, or unwritable medium)"
    fi
    umount "$OVERRIDE_MNT" 2>/dev/null || true
    rmdir "$OVERRIDE_MNT" 2>/dev/null || true
fi

# ---------------------------------------------------------------- hostname
HN="kali-live"
if [ -r "$CFG_DIR/hostname" ]; then
    HN=$(head -n1 "$CFG_DIR/hostname" 2>/dev/null || echo kali-live)
fi
if [ -n "$O_HOST" ]; then
    if valid_hostname "$O_HOST"; then
        HN="$O_HOST"
    else
        log "WARNING: invalid HOSTNAME in boot-medium config ignored"
    fi
fi

if [ "$(hostname)" != "$HN" ]; then
    hostnamectl set-hostname "$HN" 2>/dev/null || hostname "$HN" 2>/dev/null || true
fi
echo "$HN" > /etc/hostname 2>/dev/null || true

# keep /etc/hosts consistent (avoids "unable to resolve host" noise)
if grep -q '^127\.0\.1\.1[[:space:]]' /etc/hosts 2>/dev/null; then
    sed -i -e "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t$HN/" /etc/hosts
else
    printf '127.0.1.1\t%s\n' "$HN" >> /etc/hosts
fi

# --------------------------------------------------------------- live user
USER=kali
if ! getent passwd "$USER" > /dev/null 2>&1; then
    log "user '$USER' missing (live-config has not run yet?) — creating"
    useradd -m -c "Kali Live user" -s /bin/bash -G sudo,adm,netdev "$USER" 2>/dev/null || \
    useradd -m -c "Kali Live user" -s /bin/bash "$USER"
fi
USER_GID=$(id -g "$USER" 2>/dev/null || echo 1000)

# ------------------------------------------- console password + user groups
# SSH is public-key-only (sshd drop-in); the console password is
# randomized at EVERY boot unless LIVE_PASSWORD_MODE=kali was baked
# (the standard Kali live "kali/kali" console login). The random value is
# never logged, stored anywhere readable, or printed — with
# passwordless sudo configured, the normal admin path is the SSH key.
MODE=$(sed -n 's/^LIVE_PASSWORD_MODE=//p' /etc/default/kali-live-headless 2>/dev/null | head -n1)
# the file is shell-sourced style: VALUE may carry quotes. tr, not ${MODE//\"/}:
# pattern substitution is a bashism — /bin/sh (dash) aborts the whole script
# with "Bad substitution" at runtime (build #11, every boot, provision dead).
MODE=$(printf '%s' "$MODE" | tr -d \'\")
[ -n "$MODE" ] || MODE=random
# derived: deterministic per-(stick,machine) password — the operator can
# compute it OFFLINE from the salt + fingerprint (derive_identity.py) and
# never read a banner. Tradeoff vs random: it is replayable (same value
# every boot); random rotates per boot. Choose per deployment.
if [ "$MODE" = derived ]; then
    _cfgmnt=""
    _odev=$(klh_cfgpart)
    if [ -n "$_odev" ] && mkdir -p /run/klh-derive && mount -o ro "$_odev" /run/klh-derive 2>/dev/null; then
        _cfgmnt=/run/klh-derive
    fi
    _salt=$(klh_salt_of "$_cfgmnt/master.salt")
    klh_salt_valid "$_salt" || _salt=""
    if [ -n "$_salt" ]; then
        PW=$(python3 /usr/local/lib/kali-live-headless/derive_identity.py "$_salt" --machine --purpose console 2>/dev/null)
    fi
    [ -n "$_cfgmnt" ] && umount "$_cfgmnt" 2>/dev/null; rmdir /run/klh-derive 2>/dev/null
    if [ -n "$PW" ]; then
        printf '%s:%s\n' "$USER" "$PW" | chpasswd > /dev/null 2>&1 \
            && log "console password for '$USER' derived from the master salt (computable offline; replayable by design)"
    else
        log "derived password requested but no master salt — password left at live default (kali/kali); re-provision after first boot with a salt"
    fi
fi
if [ "$MODE" = random ]; then
    PW=$(head -c 32 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -d '/+=' | cut -c1-20)
    if [ -n "$PW" ]; then
        printf '%s:%s\n' "$USER" "$PW" | chpasswd > /dev/null 2>&1 \
            && log "console password for '$USER' randomized (SSH remains key-only; sudo is passwordless)"
    fi
fi

# M2: optionally bind sshd to wg0 only (close the LAN-facing ssh hole).
# Requires the WireGuard tunnel to be up — the wg-ensure timer brings it
# within 30s; sshd restarts when it lands.
WG_ONLY=$(sed -n 's/^SSHD_WG_ONLY=//p' /etc/default/kali-live-headless 2>/dev/null | head -n1 | tr -d '"')
if [ "$WG_ONLY" = true ] && [ -d /sys/class/net/wg0 ]; then
    WG_ADDR=$(ip -4 addr show wg0 2>/dev/null | grep -oE 'inet [0-9.]+' | cut -d' ' -f2)
    if [ -n "$WG_ADDR" ]; then
        printf 'ListenAddress %s\n' "$WG_ADDR" > /etc/ssh/sshd_config.d/0010-wg-only.conf
        systemctl restart ssh 2>/dev/null || true
        log "sshd bound to wg0 only ($WG_ADDR) — LAN hole closed"
    fi
fi

# SSH rate limiting: >7 new connections/minute per source IP gets dropped.
# Password auth is already disabled; this blunts key-probing and DoS.
# NOTE the threshold history: 3/min latched THREE legitimate consumers in
# one day (2026-10-26: the operator's own ssh loop, the QEMU suite, and
# the hardware battery — the recent module's --update refreshes the window
# on every match, so ONE connection over threshold seals the source and
# every retry re-seals it). 7/min keeps the brute-force value while leaving
# room for automation; multiplexed clients (ControlMaster) are immune.
# Rules are best-effort — if iptables isn't available the stick still
# boots fine (sshd's own MaxAuthTries + publickey-only are the real gates).
# IPv6 gap fix (2026-10-25): the stick has global IPv6 addresses and SSH
# accepts both protocols, but the rate limiter was IPv4-only — anyone
# connecting via IPv6 bypassed it entirely. Mirror the rules into ip6tables.
for IPT in iptables ip6tables; do
    if command -v "$IPT" >/dev/null 2>&1; then
        "$IPT" -C INPUT -p tcp --dport 22 -m conntrack --ctstate NEW -m recent --name sshprobe --set 2>/dev/null || {
            "$IPT" -I INPUT -p tcp --dport 22 -m conntrack --ctstate NEW -m recent --name sshprobe --set
            "$IPT" -I INPUT -p tcp --dport 22 -m conntrack --ctstate NEW -m recent --name sshprobe --update --seconds 60 --hitcount 8 -j DROP
            log "ssh rate limiting ($IPT): max 7 new connections/minute per source"
        }
    fi
done

# KVM/libvirt access for the live user (groups only exist on WITH_KVM builds)
for grp in kvm libvirt libvirt-qemu; do
    if getent group "$grp" > /dev/null 2>&1; then
        usermod -aG "$grp" "$USER" 2>/dev/null || true
    fi
done

# --------------------------------------------------------- authorized_keys
if [ -s "$CFG_DIR/authorized_keys" ]; then
    # Primary path: live-config creates $USER from /etc/skel on every boot,
    # so the staged /etc/skel/.ssh/authorized_keys normally lands here on
    # its own. This makes it certain, with StrictModes-clean ownership.
    install -d -m 0700 -o "$USER" -g "$USER_GID" "/home/$USER/.ssh"
    install -m 0600 -o "$USER" -g "$USER_GID" \
        "$CFG_DIR/authorized_keys" "/home/$USER/.ssh/authorized_keys"
    chown "$USER:$USER_GID" "/home/$USER" 2>/dev/null || true

    # Keep skel current too (covers the fallback user-creation path).
    install -d -m 0700 /etc/skel/.ssh
    install -m 0600 "$CFG_DIR/authorized_keys" /etc/skel/.ssh/authorized_keys
    NKEYS=$(grep -c -v '^[[:space:]]*\(#\|$\)' "$CFG_DIR/authorized_keys" 2>/dev/null || true)
    log "authorized_keys installed for '$USER' ($NKEYS key(s))"
else
    log "WARNING: $CFG_DIR/authorized_keys is missing or empty"
fi

# ----------------------------------------------------------- sshd hardening
if [ -e /etc/ssh/sshd_config ] && [ ! -f /etc/ssh/sshd_config.d/0000-kali-live-headless.conf ]; then
    if [ -r "$CFG_DIR/sshd_config.d/0000-kali-live-headless.conf" ]; then
        install -D -m 0644 \
            "$CFG_DIR/sshd_config.d/0000-kali-live-headless.conf" \
            /etc/ssh/sshd_config.d/0000-kali-live-headless.conf
        log "restored sshd hardening drop-in"
    else
        log "WARNING: sshd hardening drop-in missing"
    fi
fi

# --------------------------------------------------------------- host keys
# Host keys are baked per-build at ISO build time (openssh-server postinst).
# Regenerate only if they somehow vanished, otherwise the fingerprint of
# every boot would change and clients would complain.
if [ ! -s /etc/ssh/ssh_host_ed25519_key ]; then
    log "SSH host keys missing — generating fresh ones"
    ssh-keygen -A > /dev/null 2>&1 || true
fi

# ------------------------------------------------- Wi-Fi profile override
# Applied only when the boot-medium config carries a complete credential
# set. The generator validates and escapes; on any failure the baked
# profile is kept (all-or-nothing, predictable).
if [ -n "$O_SSID" ] && [ -n "$O_PSK" ] && [ -x "$GEN" ] && [ -r "$TEMPLATE" ]; then
    if KLH_SSID="$O_SSID" KLH_PSK="$O_PSK" KLH_KEYMGMT="$O_KEYMGMT" \
       KLH_HIDDEN="$O_HIDDEN" KLH_TEMPLATE="$TEMPLATE" \
       "$GEN" > "$NM_PROFILE.new" 2>/dev/null; then
        chown root:root "$NM_PROFILE.new" 2>/dev/null || true
        chmod 0600 "$NM_PROFILE.new"
        mv -f "$NM_PROFILE.new" "$NM_PROFILE"
        log "Wi-Fi profile regenerated from boot-medium config (no rebuild needed)"
        # no-op this early (we run Before=NetworkManager); covers late re-runs
        command -v nmcli > /dev/null 2>&1 && nmcli connection reload 2>/dev/null || true
    else
        rm -f "$NM_PROFILE.new" 2>/dev/null || true
        log "WARNING: boot-medium headless-wifi.conf rejected (invalid values) — baked credentials kept"
    fi
elif [ -n "$O_SSID" ] || [ -n "$O_PSK" ]; then
    log "WARNING: boot-medium config has incomplete Wi-Fi values — baked credentials kept"
fi

# ------------------------------------------------------- regulatory domain
REGDOM="$O_REGDOM"
if [ -z "$REGDOM" ] && [ -r /etc/default/kali-live-headless ]; then
    # shellcheck disable=SC1091
    . /etc/default/kali-live-headless
    REGDOM=${WIFI_REGDOM:-}
fi
if [ -n "$REGDOM" ] && command -v iw > /dev/null 2>&1; then
    if valid_regdom "$REGDOM"; then
        iw reg set "$REGDOM" 2>/dev/null || true
        log "Wi-Fi regulatory domain set to $REGDOM"
    else
        log "WARNING: invalid WIFI_REGDOM '$REGDOM' ignored"
    fi
fi

# ------------------------------------------------------------------ avahi
if command -v systemctl > /dev/null 2>&1; then
    if systemctl is-active --quiet avahi-daemon 2>/dev/null; then
        # --no-block: a plain try-restart from inside this unit deadlocks
        # on reruns — avahi's restart job queues behind our own (Before=)
        # activation, which waits for this script to exit. At boot avahi
        # is not up yet, so only manual/idempotent reruns hit it.
        systemctl try-restart --no-block avahi-daemon 2>/dev/null || true
    fi
fi

log "provisioning complete (hostname=$(hostname), user=$USER)"
# The suite's settle signal: written at the very END, after every step.
# Earlier markers (blackbox logs dir appearing before its final stable
# activation, the banner file not being ordered after provision) fired
# mid-run and the assert stage read a half-provisioned machine.
: > /run/kali-live-headless.settled
exit 0
