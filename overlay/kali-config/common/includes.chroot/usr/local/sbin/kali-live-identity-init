#!/bin/sh
# kali-live-identity-init — the master-salt lifecycle for deterministic
# per-machine identities (see derive_identity.py for the full design).
#
# ONE 256-bit salt is generated on the stick's FIRST boot and persisted to
# the KLHCONFIG partition (master.salt, 0600, plaintext — same threat model
# as the Wi-Fi PSK: physical access to the stick is game over; the salt is
# the master secret for every identity of every machine this stick boots).
# It is never rotated automatically; deleting it re-keys everything.
#
# This script only manages the salt. The consumers (wireguard-init,
# host-role, fips seeding in provision) derive from it via
# derive_identity.py — identities are NOT persisted (they're deterministic).
#
# Usage: kali-live-identity-init <config-mount-dir>
# Prints: the salt hex on stdout (for provision's log — the salt IS the
# secret, so provision must not log the value; this prints only a prefix).

set -u
# canonical cfgpart/salt helpers (dedup 2026-10-25)
# Source the canonical lib. The existence test (not `. file || . file`) is
# deliberate: `.` is a POSIX special builtin, and a FAILING special builtin
# is FATAL to the shell in POSIX mode (bash-as-/bin/sh) — the || fallback
# would never run. Both paths are the same file in-image; the second makes
# the script runnable straight from a checkout (tests, dry runs).
if [ -f /usr/local/lib/kali-live-headless/klh-lib.sh ]; then
    . /usr/local/lib/kali-live-headless/klh-lib.sh
else
    . "$(dirname "$0")/../lib/kali-live-headless/klh-lib.sh"
fi

[ $# -ge 1 ] && [ -d "$1" ] || { echo "identity: no config mount — salt not created" >&2; exit 1; }
SALT_FILE="$1/master.salt"

S=$(klh_salt_of "$SALT_FILE")
if [ -n "$S" ] || [ -e "$SALT_FILE" ]; then
    if [ ! -s "$SALT_FILE" ]; then
        # 0 bytes can only be a broken write (found live 2026-10-24: a
        # manually-seeded empty master.salt was accepted by every consumer's
        # `test -r` and silently blocked all salt-derived identities). No
        # operator intent is representable in an empty file — regenerate.
        echo "identity: $SALT_FILE is EMPTY (0 bytes — broken write, not an operator secret); regenerating" >&2
        rm -f "$SALT_FILE"
    else
        # existing salt: sanity-check shape, nothing to do
        klh_salt_valid "$S" \
            || { echo "identity: $SALT_FILE malformed (not >=64 hex chars) — refusing; delete it to re-key" >&2; exit 1; }
        echo "salt-present"
        exit 0
    fi
fi

# generate: 32 bytes from the CSPRNG, hex
S=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
umask 077
printf '%s\n' "$S" > "$SALT_FILE" || { echo "identity: cannot persist salt" >&2; exit 1; }
echo "salt-created"
exit 0
