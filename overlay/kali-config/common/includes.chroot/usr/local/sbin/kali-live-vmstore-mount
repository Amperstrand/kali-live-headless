#!/bin/sh
# kali-live-vmstore-mount — opt-in NTFS VM store: mount + libvirt pool.
#
# Milestone M1 of docs/vm-store-ntfs-research.md. When the boot medium's
# KLHCONFIG partition carries a valid vm-store.conf, this finds the NTFS
# partition (e.g. the gaming PC's Windows C:), mounts it read-write with
# ntfs-3g, ensures the configured folder (default C:\vms) exists, and
# defines a libvirt directory storage pool over it. VM images then live
# in a file on the NTFS disk instead of RAM.
#
# GATES (research doc §2 — each is a hard precondition, not advice):
#   * forensic boot (kernel cmdline 'noautomount')  -> never mount
#   * BitLocker-encrypted partition (FSTYPE BitLocker) -> refuse
#   * hibernated / Fast-Startup volume              -> ntfs-3g mount fails;
#     we surface the remediation (disable Fast Startup in Windows) and
#     NEVER use remove_hiberfile/force
#   * no vm-store.conf / enabled!=true              -> quiet no-op (exit 0)
#
# The Windows install is inside the live host's blast radius while this
# mount exists: the feature ships DISABLED and only ever mounts RW when
# explicitly configured (same trust decision as the Wi-Fi PSK, see README
# "Threat model").
#
# Testability: --dry-run parses the config and resolves the plan (device,
# options, pool target) WITHOUT mounting — driven by env overrides
# KLH_VMSTORE_CONF / KLH_PROC_CMDLINE / KLH_LSBLK_FILE so the suite can
# unit-test every gate as a non-root user.
#
# POSIX sh only — dash parses this file; no bashisms (build #11 lesson).

set -u

TAG=kali-live-vmstore
MNT=/mnt/klh-vmstore
POOL=klh-vmstore
ENVFILE=/run/kali-live-vmstore.env
DRY_RUN=false

log() {
    logger -t "$TAG" -- "$*" 2>/dev/null || true
    # console copy: only when writable (non-root dry-runs would otherwise
    # spray redirect errors)
    if [ -w /dev/console ]; then
        printf '[%s] %s\n' "$TAG" "$*" > /dev/console 2>/dev/null || true
    fi
}

# ------------------------------------------------------------- config input
# KLHCONFIG partition (same discovery as kali-live-headless-provision)CONF_SOURCE=""
if [ -n "${KLH_VMSTORE_CONF:-}" ]; then
    CONF_SOURCE=$KLH_VMSTORE_CONF          # unit tests: config from a file
elif [ -b /dev/disk/by-label/KLHCONFIG ]; then
    CONF_SOURCE=/dev/disk/by-label/KLHCONFIG
else
    CONF_SOURCE=$(lsblk -rno NAME,LABEL 2>/dev/null | awk '$2 == "KLHCONFIG" { print "/dev/" $1; exit }')
fi

CMDLINE=/proc/cmdline
[ -n "${KLH_PROC_CMDLINE:-}" ] && CMDLINE=$KLH_PROC_CMDLINE

# lsblk source: real block devices, or a fixture file for --dry-run tests
lsblk_rows() {
    if [ -n "${KLH_LSBLK_FILE:-}" ]; then
        cat "$KLH_LSBLK_FILE"
    else
        lsblk -rno NAME,FSTYPE,LABEL,SIZE,PARTUUID 2>/dev/null
    fi
}

conf_value() { # $1=file $2=KEY -> first plain KEY=value value
    [ -r "$1" ] || return 1
    sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1
}

valid_dirname() { # single path component, Windows-legal
    printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._-]{1,32}$'
}

valid_driver() {
    [ "$1" = "ntfs-3g" ] || [ "$1" = "ntfs3" ]
}

# read config from the KLHCONFIG partition (mounted ro, then released)
read_conf() { # -> echoes the conf file to stdout
    [ -n "$CONF_SOURCE" ] || return 1
    if [ -f "$CONF_SOURCE" ]; then
        cat "$CONF_SOURCE" 2>/dev/null
        return 0
    fi
    [ -b "$CONF_SOURCE" ] || return 1
    tmp=$(mktemp -d /run/kali-live-vmstore-conf.XXXXXX 2>/dev/null) || return 1
    if mount -o ro "$CONF_SOURCE" "$tmp" 2>/dev/null; then
        cat "$tmp/vm-store.conf" 2>/dev/null
        umount "$tmp" 2>/dev/null || true
    fi
    rmdir "$tmp" 2>/dev/null || true
    return 0
}

CONF=$(read_conf) || CONF=""
if [ -z "$CONF" ]; then
    # quiet no-op: feature ships disabled, absent config is normal
    log "no vm-store.conf on KLHCONFIG — VM store not configured (no-op)"
    exit 0
fi
CONFFILE=$(mktemp /tmp/vmstore-conf.XXXXXX 2>/dev/null || echo /dev/null)
printf '%s\n' "$CONF" > "$CONFFILE" 2>/dev/null || true

ENABLED=$(conf_value "$CONFFILE" enabled)
PARTITION=$(conf_value "$CONFFILE" partition)
DIR=$(conf_value "$CONFFILE" dir)
DRIVER=$(conf_value "$CONFFILE" driver)
RESERVED=$(conf_value "$CONFFILE" reserved_free_mb)

# ------------------------------------------------------------- gates
if [ "$ENABLED" != "true" ]; then
    log "vm-store.conf present but enabled!=true — VM store stays off"
    rm -f "$CONFFILE" 2>/dev/null || true
    exit 0
fi

if grep -qw noautomount "$CMDLINE" 2>/dev/null; then
    log "forensic boot (noautomount) — VM store deliberately NOT mounted"
    rm -f "$CONFFILE" 2>/dev/null || true
    exit 0
fi

[ -n "$PARTITION" ] || PARTITION=auto
[ -n "$DIR" ] || DIR=vms
[ -n "$DRIVER" ] || DRIVER=ntfs-3g
[ -n "$RESERVED" ] || RESERVED=20480
if ! valid_dirname "$DIR"; then
    log "ERROR: vm-store.conf 'dir' must be one Windows-legal path component (got invalid value) — refusing"
    rm -f "$CONFFILE" 2>/dev/null || true
    exit 1
fi
if ! valid_driver "$DRIVER"; then
    log "ERROR: vm-store.conf 'driver' must be ntfs-3g or ntfs3 — refusing"
    rm -f "$CONFFILE" 2>/dev/null || true
    exit 1
fi
case "$RESERVED" in
    ''|*[!0-9]*) log "ERROR: vm-store.conf 'reserved_free_mb' must be a positive integer — refusing"; rm -f "$CONFFILE" 2>/dev/null || true; exit 1 ;;
esac

# ------------------------------------------------------------- partition pick
# rows: NAME FSTYPE LABEL SIZE PARTUUID  (SIZE like 123.4G/512M for lsblk;
# fixtures may use plain MB numbers — both sort fine with sort -g on the
# numeric prefix)
pick_device() {
    case "$PARTITION" in
        /dev/*)
            lsblk_rows | awk -v d="${PARTITION#/dev/}" '$1 == d {print "/dev/" $1; exit}'
            ;;
        LABEL:*)
            lsblk_rows | awk -v l="${PARTITION#LABEL:}" '$3 == l {print "/dev/" $1; exit}'
            ;;
        PARTUUID:*)
            # fstype-agnostic on purpose: this is the owner's explicit
            # pointer — the BitLocker-encrypted C: is legitimately selected
            # here and handled by the BitLocker branch below (contract with
            # kali-live-bitlocker-mount, 6570f12). Wrong targets fail at
            # the mount step.
            lsblk_rows | awk -v u="${PARTITION#PARTUUID:}" '$5 == u {print "/dev/" $1; exit}'
            ;;
        auto)
            # largest NTFS partition (the Windows system disk on the target
            # machines) — sizes must be normalized to MB BEFORE sorting:
            # lsblk prints unit-suffixed strings ("500G" vs "1.5T") and a
            # plain numeric sort picks 500 > 1.5. BitLocker volumes are
            # excluded by the FSTYPE filter and get their own refusal below
            # when they are the only candidate.
            lsblk_rows | awk '
                function mb(s,  u, v) {
                    u = substr(s, length(s), 1)
                    if (u !~ /[KMGTPE]/) return s + 0
                    v = substr(s, 1, length(s) - 1) + 0
                    if (u == "K") return v / 1024
                    if (u == "M") return v
                    if (u == "G") return v * 1024
                    if (u == "T") return v * 1048576
                    if (u == "P") return v * 1073741824
                    return v * 1099511627776
                }
                $2 == "ntfs" { printf "%.0f /dev/%s\n", mb($4), $1 }
            ' | sort -rn | head -n 1 | cut -d' ' -f2-
            ;;
        *)
            echo ""
            ;;
    esac
}

# BitLocker probe: on an auto-selected store, ANY BitLocker volume on the
# system means the machine's Windows volume is encrypted and 'auto' must
# not guess — the only plaintext NTFS left is typically the 1.1G WinRE
# RECOVERY partition, which auto would happily RW-mount (found on real
# hardware 2026-10-23: auto picked nvme0n1p4 on the BitLocker gaming PC).
# Explicit LABEL:/PARTUUID: selectors bypass this: they name the owner-made
# dedicated VMSTORE partition (research doc §2.2 / §8 option A).
# --------------------------------------------- BitLocker consent (two keys)
# Consent to opportunistically unlock BitLocker volumes comes from EITHER:
#   1. the build-time staged gate VMSTORE_BITLOCKER=try in /etc/default
#      (configure.sh --bitlocker-unlock try — the bitlocker-mount tool
#      enforces this one itself for try-mount), OR
#   2. bitlocker=try in the stick's OWN vm-store.conf (KLHCONFIG) — the
#      same stick-over-ISO precedence as headless-wifi.conf. Owner asked
#      for opportunistic operation (2026-10-23): this makes the feature
#      work on already-built images without a rebuild. The stick IS the
#      trust object (PSK precedent, README "Threat model").
# No consent from either source = no unlock, ever.
BLKM="${KLH_BLKM:-/usr/local/sbin/kali-live-bitlocker-mount}"
ETC_DEFAULT="${KLH_ETC_DEFAULT:-/etc/default/kali-live-headless}"
BLK_CONSENT=$(conf_value "$CONFFILE" bitlocker | tr -d '\r')
case "$BLK_CONSENT" in
    ""|try|off) ;;
    *) log "ERROR: vm-store.conf 'bitlocker' must be try or off — refusing"; rm -f "$CONFFILE" 2>/dev/null || true; exit 1 ;;
esac
CONSENT_STAGED=false; CONSENT_STICK=false
grep -q "^VMSTORE_BITLOCKER=\"\?try" "$ETC_DEFAULT" 2>/dev/null && CONSENT_STAGED=true
[ "$BLK_CONSENT" = try ] && CONSENT_STICK=true
BLK_CONSENT_ANY=false
[ "$CONSENT_STAGED" = true ] || [ "$CONSENT_STICK" = true ] && BLK_CONSENT_ANY=true

bitlocker_devices() { # every BitLocker partition, one /dev/NAME per line
    lsblk_rows | awk '$2 ~ /^[Bb]it[Ll]ocker$/ {print "/dev/" $1}'
}
bitlocker_present() {
    [ -n "$(bitlocker_devices)" ]
}

DEVICE=$(pick_device)
DEV_FSTYPE=""
BLK_MODE=no
BLK_EXPECTED=""
UNLOCK_PATH=""   # try-mount (staged consent) | mount-loop (stick consent)

if [ "$PARTITION" = auto ]; then
    if bitlocker_present; then
        # auto + BitLocker volumes: the old rule was a flat refusal (the
        # plaintext auto-pick would have targeted the WinRE decoy). With
        # consent, auto becomes OPPORTUNISTIC: unlock the first BitLocker
        # volume that opens (owner directive 2026-10-23 — "automatic on
        # the other computer"). Without consent the refusal stands.
        if [ "$BLK_CONSENT_ANY" = true ]; then
            BLK_MODE=yes
            BLK_EXPECTED=""      # chosen by the unlock, logged + recorded
            DEV_FSTYPE=BitLocker
            DEVICE="(opportunistic)"
        else
            log "ERROR: partition=auto found only BitLocker volumes (C: encrypted) and no unlock consent — set bitlocker=try in vm-store.conf (or build with configure.sh --bitlocker-unlock try), or name the target explicitly; see docs/vm-store-ntfs-research.md §2.2"
            rm -f "$CONFFILE" 2>/dev/null || true
            exit 1
        fi
    elif [ -z "$DEVICE" ]; then
        log "ERROR: partition=auto found no NTFS volume at all — VM store not mounted"
        rm -f "$CONFFILE" 2>/dev/null || true
        exit 1
    fi
    # auto without BitLocker volumes: largest-NTFS pick stands
else
    # explicit selector: device must resolve; a BitLocker target needs consent
    if [ -z "$DEVICE" ]; then
        if bitlocker_present; then
            log "ERROR: no partition matches partition='$PARTITION' and BitLocker volumes are present — the Windows volume is likely encrypted; use its PARTUUID with bitlocker=try, or see docs/vm-store-ntfs-research.md §2.2"
        else
            log "ERROR: no partition matches partition='$PARTITION' — VM store not mounted"
        fi
        rm -f "$CONFFILE" 2>/dev/null || true
        exit 1
    fi
    DEV_FSTYPE=$(lsblk_rows | awk -v d="${DEVICE#/dev/}" '$1 == d {print $2; exit}')
    case "$DEV_FSTYPE" in
        BitLocker|bitlocker)
            if [ "$BLK_CONSENT_ANY" != true ]; then
                log "ERROR: $DEVICE is BitLocker-encrypted and unlock consent is absent (vm-store.conf bitlocker=try, or build-time --bitlocker-unlock try) — refusing; see docs/vm-store-ntfs-research.md §2.2"
                rm -f "$CONFFILE" 2>/dev/null || true
                exit 1
            fi
            BLK_MODE=yes
            BLK_EXPECTED=$DEVICE
            ;;
    esac
fi

if [ "$BLK_MODE" = yes ]; then
    if [ ! -x "$BLKM" ]; then
        log "ERROR: BitLocker unlock consented but $BLKM is missing (v18+ image) — refusing"
        rm -f "$CONFFILE" 2>/dev/null || true
        exit 1
    fi
    # which unlock path: the tool's optimistic try-mount (build-staged
    # consent; the tool enforces that gate itself) or, stick-consent only,
    # a mount-loop over BitLocker volumes using the tool's explicit mount
    # subcommand (not consent-gated — consent lives on the stick here).
    if [ "$CONSENT_STAGED" = true ]; then
        UNLOCK_PATH=try-mount
    else
        UNLOCK_PATH=mount-loop
    fi
fi

# ------------------------------------------------------------- driver pick
# Default ntfs-3g (safety, research §1). ntfs3 only when explicitly chosen
# AND the kernel module exists — build #14's kernel (7.1.5+kali) does not
# ship it.
# MOUNT TYPE NOTE: mounting FUSE via `mount -t fuseblk -o uid=...` fails on
# the new mount API — util-linux passes 'uid' to fsconfig() and the kernel
# fuseblk parser rejects it ("Unknown parameter 'uid'", seen live on the
# #901 stage run). Mounting via the ntfs-3g HELPER (`mount -t ntfs-3g`)
# routes the options to the userspace driver, which owns uid/gid/umask;
# /proc/mounts still reports fuseblk.
MOUNT_TYPE=""
if [ "$DRIVER" = "ntfs-3g" ]; then
    if command -v ntfs-3g >/dev/null 2>&1; then
        MOUNT_TYPE=ntfs-3g
    else
        log "ERROR: driver=ntfs-3g but ntfs-3g is not installed — refusing (install ntfs-3g or choose ntfs3 deliberately)"
        rm -f "$CONFFILE" 2>/dev/null || true
        exit 1
    fi
else # ntfs3
    if modprobe ntfs3 >/dev/null 2>&1 || grep -qw ntfs3 /proc/filesystems 2>/dev/null; then
        MOUNT_TYPE=ntfs3
    else
        log "ERROR: driver=ntfs3 but the kernel has no ntfs3 module — refusing"
        rm -f "$CONFFILE" 2>/dev/null || true
        exit 1
    fi
fi

# uid/gid mapping: every file on the mount appears owned by the qemu
# runtime user (libvirt chowns image files to it at domain start; on a
# uid-mapped ntfs mount that chown is the no-op success it needs to be).
# group kvm: the live user is a member (provisioner) and can manage images.
QEMU_UID=""; QEMU_GID=""
if QEMU_USER=$(getent passwd libvirt-qemu 2>/dev/null | cut -d: -f1) && [ -n "$QEMU_USER" ]; then
    QEMU_UID=$(id -u "$QEMU_USER" 2>/dev/null || echo "")
    QEMU_GID=$(getent group kvm 2>/dev/null | cut -d: -f3 || echo "")
    [ -n "$QEMU_GID" ] || QEMU_GID=$(id -g "$QEMU_USER" 2>/dev/null || echo "")
fi
if [ -z "$QEMU_UID" ] || [ -z "$QEMU_GID" ]; then
    log "ERROR: libvirt runtime user/group not found (libvirt-daemon-system missing?) — refusing to mount without usable ownership mapping"
    rm -f "$CONFFILE" 2>/dev/null || true
    exit 1
fi
MOUNT_OPTS="uid=$QEMU_UID,gid=$QEMU_GID,umask=007,windows_names"

# ------------------------------------------------------------- dry run plan
plan() {
    [ "$DRY_RUN" = true ] || return 0
    printf 'plan device=%s\n' "$DEVICE"
    printf 'plan fstype=%s\n' "$DEV_FSTYPE"
    printf 'plan bitlocker=%s\n' "$BLK_MODE"
    [ "$BLK_MODE" = yes ] && printf 'plan unlock=%s:%s\n' "$UNLOCK_PATH" "$(basename "$BLKM")"
    printf 'plan type=%s\n' "$MOUNT_TYPE"
    printf 'plan options=%s\n' "$MOUNT_OPTS"
    printf 'plan target=%s\n' "$MNT"
    printf 'plan store_dir=%s\n' "$MNT/$DIR"
    printf 'plan pool=%s\n' "$POOL"
    printf 'plan reserved_free_mb=%s\n' "$RESERVED"
}

# ------------------------------------------------------------- mount + pool
# BitLocker orchestration (contract with kali-live-bitlocker-mount):
#  * staged consent  -> try-mount (their optimistic first-that-unlocks;
#    the tool applies --uid/--gid/--umask to its ntfs-3g mount)
#  * stick consent   -> mount-loop over BitLocker volumes with the tool's
#    explicit `mount` subcommand (not consent-gated in the tool; consent
#    lives in the stick's vm-store.conf here)
# Both: hibernation safety is the tool's (hiberfil.sys degrades --rw to
# ro) and a read-only result REFUSES the store (images need rw). With an
# explicit selector the unlocked volume MUST match it.
blk_unlock() {
    MOUNTED_DEV=""
    if [ "$UNLOCK_PATH" = try-mount ]; then
        if ! "$BLKM" try-mount "$MNT" --rw --uid="$QEMU_UID" --gid="$QEMU_GID" --umask=007 >/tmp/vmstore-blkm.out 2>/tmp/vmstore-blkm.err; then
            log "ERROR: BitLocker try-mount failed: $(head -c 200 /tmp/vmstore-blkm.err 2>/dev/null || echo unknown)"
            rm -f /tmp/vmstore-blkm.out /tmp/vmstore-blkm.err
            exit 1
        fi
        rm -f /tmp/vmstore-blkm.out /tmp/vmstore-blkm.err
        MOUNTED_DEV=$(awk -v m="$MNT" '$2 == m {print "/dev/" $1; exit}' \
            "${KLH_BLKM_MOUNTS:-/run/kali-live-headless/bitlocker.mounts}" 2>/dev/null || true)
        [ -n "$MOUNTED_DEV" ] || { log "ERROR: try-mount reported success but $MNT is not in the mounts ledger"; exit 1; }
    else
        for d in $(bitlocker_devices); do
            if "$BLKM" mount "$d" "$MNT" --rw --uid="$QEMU_UID" --gid="$QEMU_GID" --umask=007 >/tmp/vmstore-blkm.out 2>/tmp/vmstore-blkm.err; then
                MOUNTED_DEV=$d
                break
            fi
            log "unlock of $d failed (no clear key / no bitlocker.conf entry) — trying next"
        done
        rm -f /tmp/vmstore-blkm.out /tmp/vmstore-blkm.err
        [ -n "$MOUNTED_DEV" ] || { log "ERROR: no BitLocker volume unlocked — store not mounted (consent present, but no usable key: protection resumed? add KLHCONFIG bitlocker.conf)"; exit 1; }
    fi
    if [ -n "$BLK_EXPECTED" ] && [ "$MOUNTED_DEV" != "$BLK_EXPECTED" ]; then
        log "ERROR: unlock landed on $MOUNTED_DEV but vm-store.conf selected $BLK_EXPECTED — refusing the mismatched volume (unmounting)"
        "$BLKM" unmount "$MNT" >/dev/null 2>&1 || true
        exit 1
    fi
    DEVICE=$MOUNTED_DEV   # record what actually opened (logs + ENVFILE)
    if findmnt -no OPTIONS "$MNT" 2>/dev/null | grep -qE '(^|,)ro(,|$)'; then
        log "ERROR: $DEVICE unlocked READ-ONLY (hibernated Windows — the tool's hiberfil guard) — a VM store needs rw. Boot Windows, 'powercfg /h off', shut down FULLY, retry"
        "$BLKM" unmount "$MNT" >/dev/null 2>&1 || true
        exit 1
    fi
}

do_mount() {
    if mountpoint -q "$MNT" 2>/dev/null; then
        log "$MNT already mounted — reusing"
        return 0
    fi
    mkdir -p "$MNT" || { log "ERROR: cannot create $MNT"; exit 1; }
    if [ "$BLK_MODE" = yes ]; then
        blk_unlock
        log "BitLocker volume $DEVICE unlocked and mounted rw at $MNT"
        return 0
    fi
    if ! mount -t "$MOUNT_TYPE" -o "$MOUNT_OPTS" "$DEVICE" "$MNT" 2>/tmp/vmstore-mount.err; then
        ERR=$(cat /tmp/vmstore-mount.err 2>/dev/null || echo unknown)
        rm -f /tmp/vmstore-mount.err
        case "$ERR" in
            *hibernat*|*Hibernat*)
                log "ERROR: $DEVICE is hibernated (Windows Fast Startup?) — refusing RW mount. Boot Windows, run 'powercfg /h off', shut down FULLY, then reboot the stick (never use remove_hiberfile)"
                ;;
            *dirty*|*unclean*)
                log "ERROR: $DEVICE is marked dirty and was not mounted: $ERR"
                ;;
            *)
                log "ERROR: mount of $DEVICE failed: $ERR"
                ;;
        esac
        exit 1
    fi
    log "mounted $DEVICE at $MNT (type $MOUNT_TYPE, opts $MOUNT_OPTS)"
}

do_pool() {
    STORE_DIR="$MNT/$DIR"
    mkdir -p "$STORE_DIR" || { log "ERROR: cannot create store dir $STORE_DIR"; exit 1; }

    # free-space warning (kali-live-vm-create enforces reserved_free_mb)
    AVAIL_MB=$(df -Pm "$STORE_DIR" 2>/dev/null | awk 'NR==2 {print $4}')
    if [ -n "$AVAIL_MB" ] && [ "$AVAIL_MB" -lt "$RESERVED" ] 2>/dev/null; then
        log "WARNING: store free space ${AVAIL_MB}MB is below reserved_free_mb=${RESERVED}MB — image creation will be refused until space frees up"
    fi

    # libvirt dir pool over the store (idempotent)
    if virsh -c qemu:///system pool-info "$POOL" >/dev/null 2>&1; then
        virsh -c qemu:///system pool-refresh "$POOL" >/dev/null 2>&1 || true
        log "libvirt pool $POOL refreshed at $STORE_DIR"
    else
        if virsh -c qemu:///system pool-define-as "$POOL" dir --target "$STORE_DIR" >/dev/null 2>&1 \
           && virsh -c qemu:///system pool-start "$POOL" >/dev/null 2>&1; then
            log "libvirt pool $POOL defined+started at $STORE_DIR"
        else
            log "ERROR: could not define/start libvirt pool $POOL at $STORE_DIR"
            exit 1
        fi
    fi

    # facts for kali-live-vm-create / -rm (no secrets)
    cat > "$ENVFILE" <<EOF
KLH_VMSTORE_DEVICE=$DEVICE
KLH_VMSTORE_MOUNT=$MNT
KLH_VMSTORE_DIR=$STORE_DIR
KLH_VMSTORE_POOL=$POOL
KLH_VMSTORE_RESERVED_MB=$RESERVED
EOF
    chmod 0644 "$ENVFILE"
    log "VM store ready: $STORE_DIR (pool $POOL, reserved ${RESERVED}MB)"
}

if [ "${1:-}" = "--dry-run" ]; then
    DRY_RUN=true
    plan
    printf 'plan result=ok\n'
    rm -f "$CONFFILE" 2>/dev/null || true
    exit 0
fi

do_mount
do_pool
rm -f "$CONFFILE" 2>/dev/null || true
exit 0
