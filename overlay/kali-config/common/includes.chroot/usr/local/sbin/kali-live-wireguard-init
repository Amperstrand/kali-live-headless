#!/bin/sh
# kali-live-wireguard-init — per-stick WireGuard identity and tunnel (M1).
#
# Credentials model (mirrors the FIPS host-role identity):
#   * the private key NEVER exists anywhere before first boot — it is
#     generated on the stick and persisted to the KLHCONFIG partition
#     (wireguard.conf, plaintext, same threat model as the Wi-Fi PSK and the
#     FIPS nsec: physical access to the stick is game over).
#   * nothing secret is baked into the ISO or committed to git. The only
#     staged values are non-secret: endpoint, peer (hub) pubkey, tunnel
#     network, port — from ./config via /etc/default/kali-live-headless.
#   * the stick's tunnel address is derived from its PUBLIC key
#     (sha256 -> two octets of WG_TUNNET), so the hub needs no per-stick IP
#     ledger: enroll `wg set wg0 peer <pubkey> allowed-ips <addr>/32`.
#
# Output: the stick's PUBLIC key on stdout (for the provision log, the
# console banner, and hub enrollment). Any secret stays on the stick.
#
# Usage: kali-live-wireguard-init <config-mount-dir>
# Exits 0 with empty output when the feature is off or unavailable.

set -u
# canonical cfgpart/salt helpers (dedup 2026-10-25)
# Source the canonical lib. The existence test (not `. file || . file`) is
# deliberate: `.` is a POSIX special builtin, and a FAILING special builtin
# is FATAL to the shell in POSIX mode (bash-as-/bin/sh) — the || fallback
# would never run. Both paths are the same file in-image; the second makes
# the script runnable straight from a checkout (tests, dry runs).
if [ -f /usr/local/lib/kali-live-headless/klh-lib.sh ]; then
    . /usr/local/lib/kali-live-headless/klh-lib.sh
else
    . "$(dirname "$0")/../lib/kali-live-headless/klh-lib.sh"
fi

ETC_DEFAULT=/etc/default/kali-live-headless

cfg_get() { # var -> value from /etc/default/kali-live-headless (quotes stripped)
    sed -n "s/^$1=//p" "$ETC_DEFAULT" 2>/dev/null | head -n 1 | tr -d \'\"
}

# FIPS optionality (v20): FIPS_ENABLED=false ships the wire dormant —
# identity (npub, and any persisted wireguard.conf) is kept, so flipping
# the value later (config partition) re-arms the mesh without re-keying.
if [ "$(cfg_get FIPS_ENABLED)" = "false" ]; then
    logger -t kali-live-wireguard-init "FIPS_ENABLED=false — mesh wire dormant (identity kept)" 2>/dev/null || true
    exit 0
fi

ENDPOINT=$(cfg_get WG_ENDPOINT)
PEER=$(cfg_get WG_PEER_PUBKEY)
TUNNET=$(cfg_get WG_TUNNET);  [ -n "$TUNNET" ] || TUNNET=10.66
HUBADDR=$(cfg_get WG_HUB_ADDR)
PORT=$(cfg_get WG_PORT);      [ -n "$PORT" ]   || PORT=51820
# TUNNET is the FIRST TWO octets of the tunnel /16 (e.g. "10.66"): stick
# addresses are $TUNNET.X.Y with X,Y derived from the public key. (The
# first cut appended two derived octets to a THREE-octet base and produced
# 5-octet addresses like 10.66.0.164.194, which `ip addr add` rejects —
# caught live on the first hardware boot of build #14, 2026-10-22.)

# --ensure: bring wg0 up if the config exists but the interface does not.
# Boot-time wg-quick fails whenever DNS cannot resolve the endpoint yet
# (provision runs before the network is fully up — proven on hardware
# 2026-10-23), and nothing retried it. The vm-forward-reassert timer calls
# this every 30s, mirroring the firewall daemon's self-healing.
if [ "${1:-}" = "--ensure" ]; then
    [ -f /etc/wireguard/wg0.conf ] || exit 0
    wg show wg0 >/dev/null 2>&1 && exit 0
    wg-quick up wg0 >/dev/null 2>&1 || exit 0
    echo "wireguard: wg0 brought up by the ensure pass"
    exit 0
fi

[ -n "$ENDPOINT" ] || { echo "wireguard: off (WG_ENDPOINT not configured)" >&2; exit 0; }
[ -n "$PEER" ]     || { echo "wireguard: WG_ENDPOINT set but WG_PEER_PUBKEY missing — refusing to bring up an unauthenticated tunnel" >&2; exit 0; }
command -v wg >/dev/null 2>&1 || { echo "wireguard: wg not installed (wireguard-tools missing)" >&2; exit 0; }
[ $# -ge 1 ] && [ -d "$1" ] || { echo "wireguard: no config mount — identity would not survive a reboot, not provisioning" >&2; exit 1; }
KV="$1/wireguard.conf"

PRIV=""; PUB=""; TUNIP=""
if [ -r "$KV" ]; then
    PRIV=$(  sed -n 's/^PRIVKEY=//p' "$KV" | head -n 1)
    PUB=$(   sed -n 's/^PUBKEY=//p'  "$KV" | head -n 1)
    TUNIP=$( sed -n 's/^TUNIP=//p'   "$KV" | head -n 1 | tr -d \'\")
fi

# Deterministic per-machine key: whenever the stick carries a VALID salt,
# the DERIVED key WINS and the persisted file is refreshed — the cache must
# never override the derivation, or a pre-salt random key (or a key from a
# deleted/re-keyed salt) shadows the identity forever (found live
# 2026-10-24: sticks booted once with an unreadable salt kept their random
# fallback key on every later boot). Same stick on a different machine gets
# a different key, and the operator can precompute the pubkey before the
# machine ever boots (tools/derive-identities).
SALT_FILE="$1/master.salt"
if [ -x /usr/local/lib/kali-live-headless/derive_identity.py ]; then
    SALT=$(klh_salt_of "$SALT_FILE")
    klh_salt_valid "$SALT" || SALT=""
    DERIVED=$(python3 /usr/local/lib/kali-live-headless/derive_identity.py "$SALT" --machine --purpose wireguard 2>/dev/null)
    if [ -n "$DERIVED" ] && [ "$DERIVED" != "$PRIV" ]; then
        PRIV=$DERIVED
        PUB=$(printf '%s\n' "$PRIV" | wg pubkey) || { echo "wireguard: wg pubkey failed on derived key" >&2; exit 1; }
        echo "wireguard: key derived from master salt (per-machine)" >&2
        # refresh the cache (keep a pinned TUNIP) so salt-less boots restore
        # the same key rather than falling back to random. KEYSOURCE records
        # provenance for the suite + forensics (derived|random).
        { printf '# kali-live-headless wireguard identity - generated on first boot.\n# PRIVKEY IS A SECRET (plaintext, same threat model as the Wi-Fi PSK).\n# TUNIP is optional (set to pin the address instead of deriving it).\n'
          printf 'KEYSOURCE=derived\nPRIVKEY=%s\nPUBKEY=%s\n' "$PRIV" "$PUB"
          [ -n "$TUNIP" ] && printf 'TUNIP=%s\n' "$TUNIP"; } > "$KV" 2>/dev/null || true
    fi
fi

if [ -z "$PRIV" ] || [ -z "$PUB" ]; then
    PRIV=$(wg genkey) || { echo "wireguard: wg genkey failed" >&2; exit 1; }
    PUB=$(printf '%s\n' "$PRIV" | wg pubkey) || { echo "wireguard: wg pubkey failed" >&2; exit 1; }
    # Persist BEFORE using it: an unpersisted key would silently rotate every
    # boot and break hub enrollment.
    if ! printf '# kali-live-headless wireguard identity - generated on first boot.\n# PRIVKEY IS A SECRET (plaintext, same threat model as the Wi-Fi PSK).\n# TUNIP is optional (set to pin the address instead of deriving it).\nKEYSOURCE=random\nPRIVKEY=%s\nPUBKEY=%s\n' \
            "$PRIV" "$PUB" > "$KV" 2>/dev/null; then
        echo "wireguard: cannot persist identity to $KV" >&2
        exit 1
    fi
fi

# Deterministic tunnel address from the PUBLIC key (never the secret).
if [ -z "$TUNIP" ]; then
    H1=$(printf '%s' "$PUB" | sha256sum | cut -c 1-2)
    H2=$(printf '%s' "$PUB" | sha256sum | cut -c 3-4)
    # 1..250 in both octets: avoid the .0 network and .255 broadcast addresses.
    # TUNNET is the first TWO octets (e.g. 10.66) -> a valid 4-octet address.
    # (The first cut appended two octets to a THREE-octet base, producing
    # 5-octet addresses that ip addr add rejects — #14's first hardware boot.)
    TUNIP="$TUNNET.$(( 0x$H1 % 250 + 1 )).$(( 0x$H2 % 250 + 1 ))"
    # Guard against a stale staged WG_TUNNET (a hotpatch child inherits the
    # parent build's baked /etc/default — #15's first hardware boot shipped
    # 10.66.0 and wg0 never came up): never write an invalid address, fall
    # back to the default base instead.
    if ! printf '%s' "$TUNIP" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        echo "wireguard: staged WG_TUNNET='$TUNNET' yields malformed address '$TUNIP' — falling back to 10.66" >&2
        TUNNET=10.66
        TUNIP="$TUNNET.$(( 0x$H1 % 250 + 1 )).$(( 0x$H2 % 250 + 1 ))"
    fi
fi

umask 077
mkdir -p /etc/wireguard
{
    printf '[Interface]\n'
    printf 'Address = %s/16\n' "$TUNIP"
    printf 'PrivateKey = %s\n' "$PRIV"
    # Guest egress and DNAT replies arrive FROM arbitrary internet addresses;
    # WireGuard's AllowedIPs is a crypto filter, so the peer must permit them.
    # Putting 0.0.0.0/0 in AllowedIPs would make wg-quick install a default
    # route and steal the host's own uplink, so widen the filter in PostUp
    # instead: routing stays table 100 (guests only). Found live 2026-10-28 —
    # the stick could reach the internet through the tunnel while guests had
    # no egress and every published-port reply was dropped.
    if [ -n "$HUBADDR" ]; then
        printf 'PostUp = wg set %%i peer %s allowed-ips %s.0.0/16,%s,0.0.0.0/0\n' \
            "$PEER" "$TUNNET" "$HUBADDR"
    else
        printf 'PostUp = wg set %%i peer %s allowed-ips %s.0.0/16,0.0.0.0/0\n' \
            "$PEER" "$TUNNET"
    fi
    printf '\n[Peer]\n'
    printf 'PublicKey = %s\n' "$PEER"
    printf 'Endpoint = %s:%s\n' "$ENDPOINT" "$PORT"
    # Route the tunnel network through the hub (peer-to-peer between peers of
    # the same hub), plus the hub's own tunnel address when it lives OUTSIDE
    # the tunnel network (e.g. sticks on 10.66.0.0/16 joining a hub at
    # 10.99.0.1) — without it, replies to the hub would leave via the
    # default route and the handshake would never complete. The stick keeps
    # its own default route (Wi-Fi/LAN) for everything else.
    if [ -n "$HUBADDR" ]; then
        printf 'AllowedIPs = %s.0.0/16, %s\n' "$TUNNET" "$HUBADDR"
    else
        printf 'AllowedIPs = %s.0.0/16\n' "$TUNNET"
    fi
    printf 'PersistentKeepalive = 25\n'
} > /etc/wireguard/wg0.conf

if ! wg show wg0 >/dev/null 2>&1; then
    wg-quick up wg0 >/dev/null 2>&1 \
        || { echo "wireguard: wg-quick up failed (endpoint unreachable?)" >&2; }
fi

# Public key only — for the provision log, banner and hub enrollment.
printf '%s %s\n' "$PUB" "$TUNIP"
