#!/bin/sh
# Load KVM modules (some boards don't auto-load via udev) and report
# whether hardware virtualization is available. THEN bring the libvirt
# default network up deterministically (block at the bottom — it must
# run on EVERY boot, before any early exit).

set -u

modprobe kvm 2>/dev/null || true
if grep -q -w vmx /proc/cpuinfo 2>/dev/null; then
    modprobe kvm_intel 2>/dev/null || true
elif grep -q -w svm /proc/cpuinfo 2>/dev/null; then
    modprobe kvm_amd 2>/dev/null || true
fi

if [ -e /dev/kvm ]; then
    logger -t kali-live-kvm "KVM module loaded, /dev/kvm available"
else
    logger -t kali-live-kvm "WARNING: no /dev/kvm (VT-x/AMD-V disabled in firmware or unsupported CPU) — libvirt falls back to slow TCG emulation"
fi

# Bring the default NAT network up deterministically. Without this,
# libvirtd socket-activation + Autostart=no meant virbr0 NEVER existed
# at boot until someone ran a virsh command — and the guest firewall
# had nothing to shield (the build #11 "active but dead" false green).
#
# REAL-HARDWARE LESSON (build #14, 2026-10-22): this block used to sit
# AFTER an `if [ -e /dev/kvm ]; then exit 0; fi` early-exit. On bare
# metal udev creates /dev/kvm during boot, the script exited at line 8,
# and the network never started: virbr0 absent, shield dead on every
# real machine. In QEMU there is no /dev/kvm in the guest, the script
# fell through, and the suite was green — a device-only branch the QEMU
# suite cannot catch. The block now runs unconditionally. virsh
# socket-activates the daemon, so it works even when libvirtd.service
# has not fully started yet.
# virsh calls are TIMEOUT-BOUNDED (build #18 lesson): an unbounded virsh
# that hangs (e.g. libvirtd wedged behind a boot-transaction deadlock)
# hangs THIS unit forever, and half of multi-user.target queues behind it
# — an unbootable stick. Bounded calls degrade to a logged warning.
if command -v virsh >/dev/null 2>&1; then
    timeout 60 virsh -c qemu:///system net-autostart default >/dev/null 2>&1 || true
    if ! timeout 60 virsh -c qemu:///system net-info default 2>/dev/null | grep -q 'Active:.*yes'; then
        if timeout 60 virsh -c qemu:///system net-start default >/dev/null 2>&1; then
            logger -t kali-live-kvm "default network started (virbr0 up; guest firewall will engage)"
        else
            logger -t kali-live-kvm "WARNING: could not start libvirt default network (virbr0 later?)"
        fi
    fi
fi
exit 0
