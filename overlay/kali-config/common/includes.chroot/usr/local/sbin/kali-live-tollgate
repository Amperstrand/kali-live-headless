#!/bin/sh
# kali-live-tollgate — auto-detect and pay a TollGate on the current network.
#
# Runs when Wi-Fi connects to an open network (the tollgate-open NM profile).
# If the gateway is a TollGate (responds on :2121 with an advertisement),
# mint Cashu tokens from the advertised mint and pay for internet access.
# On fakewallet/testnet mints the Lightning invoice auto-settles, so the
# whole flow takes <2 seconds.
#
# This script is the TRIGGER; the heavy lifting is the tollgate-client
# binary (static Go, 10MB, built from gonuts-tollgate).

set -u

LOGGER_TAG="kali-live-tollgate"
log() { logger -t "$LOGGER_TAG" "$*" 2>/dev/null || echo "tollgate: $*" >&2; }

CLIENT=/usr/local/bin/tollgate-client
[ -x "$CLIENT" ] || { log "tollgate-client not installed — skipping"; exit 0; }

# Only run when we actually have a default route (i.e., we associated)
GW=$(ip route show default 2>/dev/null | awk '{print $3; exit}')
[ -n "$GW" ] || { log "no default route — not on a TollGate network"; exit 0; }

# Quick probe: is there a TollGate on the gateway?
if ! timeout 3 wget -q -O /dev/null "http://$GW:2121/" 2>/dev/null; then
    log "no TollGate on $GW:2121 — normal network, nothing to do"
    exit 0
fi

log "TollGate detected on $GW — attempting payment"

# Run the client (discovers the advertisement, mints, pays)
OUTPUT=$("$CLIENT" --gateway "$GW" 2>&1)
RC=$?
echo "$OUTPUT" | while IFS= read -r line; do log "$line"; done

if [ "$RC" -eq 0 ]; then
    log "TollGate payment successful — internet access granted"
else
    log "TollGate payment failed (rc=$RC) — see journal for details"
fi
exit $RC
