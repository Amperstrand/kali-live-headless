#!/bin/sh
# kali-live-vm-rm — remove a VM image (and its domain, if defined) from the
# NTFS store. This is the deletion path the M1 cleanup job calls when a VM
# is no longer active: going through libvirt keeps pool state consistent
# (no dangling domains referencing deleted files).
#
# Usage:
#   kali-live-vm-rm --id NAME         remove one VM image (+ domain if any)
#   kali-live-vm-rm --stale           remove leftover TEST volumes only: no
#                                     domain defined and no .deploy/.xml
#                                     (provisioned guests are never swept —
#                                     use --id NAME for those)
#
# POSIX sh only — dash parses this file; no bashisms (build #11 lesson).

set -u

TAG=kali-live-vmstore
ENVFILE=/run/kali-live-vmstore.env

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ $# -ge 1 ] || usage

ID="" STALE=false
while [ $# -gt 0 ]; do
    case "$1" in
        --id)    ID=${2:?}; shift 2 ;;
        --stale) STALE=true; shift ;;
        -h|--help) usage ;;
        *) echo "kali-live-vm-rm: unknown option: $1" >&2; usage ;;
    esac
done

log() { logger -t "$TAG" -- "$*" 2>/dev/null || true; }
die() { log "ERROR: $*"; echo "kali-live-vm-rm: $*" >&2; exit 1; }

if [ "$STALE" = true ] && [ -n "$ID" ]; then
    die "--id and --stale are mutually exclusive"
fi
[ -n "$ID" ] || [ "$STALE" = true ] || die "need --id NAME or --stale"

if [ -r "$ENVFILE" ]; then
    # shellcheck disable=SC1090
    . "$ENVFILE"
    POOL=${KLH_VMSTORE_POOL:-klh-vmstore}
    STORE_DIR=${KLH_VMSTORE_DIR:-}
else
    # allow forced removal even when the store is not mounted (e.g. after a
    # failed boot) — but only by exact id, never the --stale sweep
    [ "$STALE" = true ] && die "store not mounted — --stale refuses to run blind"
    POOL=klh-vmstore
    STORE_DIR=""
fi

VIRSH="virsh -c qemu:///system"

remove_one() { # $1 = vm id (<id>; the volume file is <id>.image); 0 = removed
    vmid=$1
    volid="$vmid.image"
    # domain referencing it? best-effort undefine by the same name
    if $VIRSH dominfo "$vmid" >/dev/null 2>&1; then
        $VIRSH destroy "$vmid" >/dev/null 2>&1 || true
        $VIRSH undefine "$vmid" --nvram >/dev/null 2>&1 || $VIRSH undefine "$vmid" >/dev/null 2>&1 || true
        log "domain '$vmid' undefined"
    fi
    # Inbound port rules belong to the guest: a forward left behind keeps
    # publishing a port that DNATs to an address nobody owns (found live
    # 2026-10-26: a removed guest's 22024 rule survived the removal).
    # Match by name convention (<id>-*) and by the guest IP recorded in the
    # deploy state, so a half-cleaned guest still gets its rules dropped.
    fwd=
    if [ -n "$STORE_DIR" ] && [ -f "$STORE_DIR/$vmid.deploy" ]; then
        fwd=$(sed -n 's/^GUEST_IP=//p' "$STORE_DIR/$vmid.deploy" 2>/dev/null | head -1)
    fi
    for name in $(/usr/local/sbin/kali-live-vm-forward list 2>/dev/null \
            | awk -v id="$vmid" -v ip="$fwd" \
                'index($1, id "-") == 1 || (ip != "" && index($0, ip)) {print $1}'); do
        if /usr/local/sbin/kali-live-vm-forward remove "$name" >/dev/null 2>&1; then
            log "forward '$name' removed (guest '$vmid')"
        fi
    done
    if $VIRSH vol-delete "$volid" --pool "$POOL" >/dev/null 2>&1; then
        [ -n "$STORE_DIR" ] && rm -f "$STORE_DIR/$vmid.meta" 2>/dev/null || true
        # removal means removal: the deploy state, saved XML and seed are the
        # guest's identity/port record — leaving them behind makes a later
        # same-name guest look like a resurrection (found live 2026-10-26:
        # bench1's .deploy/.xml/seed outlived the volume)
        [ -n "$STORE_DIR" ] && rm -f "$STORE_DIR/$vmid.deploy" \
            "$STORE_DIR/$vmid.xml" "$STORE_DIR/$vmid-seed.iso" 2>/dev/null || true
        log "volume '$volid' deleted from pool $POOL"
        return 0
    fi
    return 1
}

if [ "$STALE" = true ]; then
    # sweep: TEST LEFTOVERS ONLY. The first cut removed every volume whose
    # domain was not RUNNING, so a deliberate `virsh destroy` (maintenance,
    # debugging, a reboot) silently deleted that guest's disk — it ate a live
    # test guest on 2026-10-26 when a suite run swept the host mid-debug.
    # A guest the platform provisioned is never swept: it carries a .deploy
    # state file / saved .xml (for --restore), or a defined domain (stopped
    # is a decision, not garbage). Removal of those is always explicit:
    #   kali-live-vm-rm --id NAME
    removed=0; kept=0
    for vol in $($VIRSH vol-list "$POOL" 2>/dev/null | awk 'NR>2 && NF>=2 {print $1}' | grep -Ev '^-+$' || true); do
        vmid=${vol%.image}
        if [ -n "$STORE_DIR" ] && { [ -f "$STORE_DIR/$vmid.deploy" ] || [ -f "$STORE_DIR/$vmid.xml" ]; }; then
            log "skip '$vol' (provisioned guest: .deploy/.xml present)"
            kept=$((kept + 1))
            continue
        fi
        if $VIRSH dominfo "$vmid" >/dev/null 2>&1; then
            log "skip '$vol' (domain defined: removal is explicit, --id $vmid)"
            kept=$((kept + 1))
            continue
        fi
        if remove_one "$vmid"; then removed=$((removed + 1)); fi
    done
    $VIRSH pool-refresh "$POOL" >/dev/null 2>&1 || true
    echo "removed $removed stale volume(s) from pool $POOL, kept $kept defined/provisioned guest(s)"
    exit 0
fi

if remove_one "$ID"; then
    $VIRSH pool-refresh "$POOL" >/dev/null 2>&1 || true
    echo "removed '$ID'"
    exit 0
fi
die "no volume '$ID' in pool $POOL (already gone? refresh with: virsh pool-refresh $POOL)"
